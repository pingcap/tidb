+
+// TestGo127MethodOrder checks real V5 export data, including the relative order
+// of ordinary and generic methods. Older compilers cannot compile this fixture.
+func TestGo127MethodOrder(t *testing.T) {
+	testenv.NeedsGo1Point(t, 27)
+	testenv.NeedsGoCommand1Point(t, 27)
+	needsCompiler(t, "gc")
+	skipWindows(t)
+
+	const src = `package fixture
+
+type T struct{}
+
+func (T) Zebra() {}
+func (T) Alpha[P any](p P) P { return p }
+func (T) Middle() {}
+func (T) Beta[P any](p P) P { return p }
+`
+	const pkgPath = "example.com/v5fixture"
+	tmp := t.TempDir()
+	if err := os.WriteFile(filepath.Join(tmp, "fixture.go"), []byte(src), 0600); err != nil {
+		t.Fatal(err)
+	}
+	compilePkg(t, tmp, "fixture.go", tmp, nil, pkgPath)
+	pkg := importPkg(t, "./fixture", tmp)
+	got := lookupObj(t, pkg.Scope(), "T").Type().(*types.Named)
+
+	fset := token.NewFileSet()
+	file, err := goparser.ParseFile(fset, "fixture.go", src, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var conf types.Config
+	checked, err := conf.Check(pkgPath, fset, []*ast.File{file}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := lookupObj(t, checked.Scope(), "T").Type().(*types.Named)
+	if got.NumMethods() != want.NumMethods() || got.NumMethods() != 4 {
+		t.Fatalf("method count: got %d, want %d (4)", got.NumMethods(), want.NumMethods())
+	}
+	for i := range got.NumMethods() {
+		gm, wm := got.Method(i), want.Method(i)
+		gs, ws := gm.Type().(*types.Signature), wm.Type().(*types.Signature)
+		if gm.Name() != wm.Name() || gs.TypeParams().Len() != ws.TypeParams().Len() {
+			t.Errorf("method %d: got %s (%d type params), want %s (%d type params)",
+				i, gm.Name(), gs.TypeParams().Len(), wm.Name(), ws.TypeParams().Len())
+		}
+		t.Logf("method %d: %s, type params=%d", i, gm.Name(), gs.TypeParams().Len())
+	}
+}
