+// An opt-in diagnostic seed controls transaction inputs, not database state,
+// wall-clock timestamps, think times, or concurrent execution order.
+func readInputSeed() *int64 {
+	raw, set := os.LookupEnv("GOTPC_TPCC_INPUT_SEED")
+	if !set {
+		return nil
+	}
+	seed, err := strconv.ParseInt(raw, 10, 64)
+	if err != nil {
+		panic(fmt.Errorf("GOTPC_TPCC_INPUT_SEED must be an int64: %w", err))
+	}
+	return &seed
+}
