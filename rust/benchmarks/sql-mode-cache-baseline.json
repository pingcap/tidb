  "status": "WIP: SQL-mode increment measured and consistency checked; no stable broad throughput gain established",
  "change": {
    "files": [
      "rust/crates/tidb-session/src/stmt_ctx.rs"
    ],
    "mechanism": "Move existing SQL-mode derivation into StatementVarSnapshot. Store scanner flags, temporal modes, strict/division/group-by/unsigned/auto-zero booleans, not a string that each query/DML builder reparses. Existing generation invalidation covers SET, restore, reseed and identity. No new parser or workload branch; preserve existing uppercase, trimming and unknown-token behavior.",
    "go_sources": [
      "pkg/executor/select.go:1098-1166",
      "pkg/sessionctx/variable/session.go (typed SQLMode field)"
    ],
    "profile_evidence": {
      "release": "23174d49",
      "path": "/private/tmp/tidb-empty-restore-mixed-active.txt",
      "scanner_mode_observations": 45,
      "context_flag_scan_observations": 44,
