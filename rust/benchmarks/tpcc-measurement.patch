-	m.RLock()
-	defer m.RUnlock()
+	m.Lock()
+	defer m.Unlock()
 	ret, m.OpCurMeasurement = m.OpCurMeasurement, make(map[string]*Histogram, 16)
 	return
 }
diff --git a/pkg/measurement/measure_test.go b/pkg/measurement/measure_test.go
