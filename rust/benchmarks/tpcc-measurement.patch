 func (m *Measurement) measure(op string, err error, lan time.Duration) {
-	m.getHist(op, err, true).Measure(lan)
-	m.getHist(op, err, false).Measure(lan)
+	key := op
+	if err != nil {
+		key += "_ERR"
+	}
+	m.RLock()
+	current, summary := m.OpCurMeasurement[key], m.OpSumMeasurement[key]
+	if current == nil || summary == nil {
+		m.RUnlock()
+		m.Lock()
+		defer m.Unlock()
+		// Recheck under the write lock: another writer or rotation may
+		// have changed either map while we waited.
+		current = m.getHistLocked(op, err, true)
+		summary = m.getHistLocked(op, err, false)
+	} else {
+		defer m.RUnlock()
+	}
+	// Keep the current window attached until both records are complete.
+	current.Measure(lan)
+	summary.Measure(lan)
 }
 
