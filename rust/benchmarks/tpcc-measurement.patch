index 0000000..744b063
--- /dev/null
+++ b/pkg/measurement/measure_test.go
@@ -0,0 +1,68 @@
+package measurement
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestConcurrentMeasurement(t *testing.T) {
+	for _, rotate := range []bool{false, true} {
+		for round := 0; round < 64; round++ {
+			m := NewMeasurement()
+			start := make(chan struct{})
+			finished := make(chan struct{})
+			var workers sync.WaitGroup
+			var windows sync.WaitGroup
+			var currentCount int64
+			collect := func() {
+				for _, h := range m.takeCurMeasurement() {
+					currentCount += h.GetInfo().Count
+				}
+			}
+			if rotate {
+				windows.Add(1)
+				go func() {
+					defer windows.Done()
+					<-start
+					for {
+						select {
+						case <-finished:
+							return
+						default:
+							collect()
+						}
+					}
+				}()
+			}
+			for worker := 0; worker < 64; worker++ {
+				workers.Add(1)
+				go func(worker int) {
+					defer workers.Done()
+					<-start
+					var err error
+					if worker%2 != 0 {
+						err = errors.New("transaction error")
+					}
+					for sample := 0; sample < 16; sample++ {
+						m.Measure("transaction", time.Millisecond, err)
+					}
+				}(worker)
+			}
+			close(start)
+			workers.Wait()
+			close(finished)
+			windows.Wait()
+			collect()
+			for _, op := range []string{"transaction", "transaction_ERR"} {
+				if got := m.OpSumMeasurement[op].GetInfo().Count; got != 512 {
+					t.Fatalf("rotate=%v round=%d %s: got %d, want 512", rotate, round, op, got)
+				}
+			}
+			if currentCount != 1024 {
+				t.Fatalf("rotate=%v round=%d current windows: got %d, want 1024", rotate, round, currentCount)
+			}
+		}
+	}
+}
