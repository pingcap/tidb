+    #[tokio::test]
+    async fn fragmented_settings_wait_for_complete_frame() {
+        for frame in [
+            vec![0, 0, 6, 4, 0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 0],
+            vec![0, 0, 0, 4, 1, 0, 0, 0, 0],
+        ] {
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let owner = Owner::new(listener.local_addr().unwrap());
+            let mut socket = accept_preface(&listener).await;
+            socket.write_all(&frame[..frame.len() - 1]).await.unwrap();
+            assert!(
+                tokio::time::timeout(Duration::from_millis(75), owner.ready())
+                    .await
+                    .is_err()
+            );
+            socket.write_all(&frame[frame.len() - 1..]).await.unwrap();
+            assert!(tokio::time::timeout(BOUND, owner.ready())
+                .await
+                .unwrap()
+                .is_ok());
+            owner.close().await;
+            assert_eof(socket).await;
+        }
+    }
