  },
  "reproduced_before": {
    "failures": 8,
    "native": 4,
    "adapter": 3,
    "etcd": 1,
    "behavior": [
      "Unreachable TSO primary rejects healthy-proxy bootstrap",
      "Valid follower membership is discarded when the leader membership probe fails",
      "Forced PD timestamp option is ignored in both clients",
      "Dial endpoint options are ignored in both clients",
      "Adapter ignores configured scheme when choosing an advertised leader URL",
      "Etcd wrapper leaves HTTPS scheme attached instead of deferring transport to configured TLS"
    ]
  },
  "repairs": [
    "Share configured lazy PD channel construction, preserving the existing TLS builder and ordinary KV eager connection behavior",
    "Publish accepted membership without a redundant leader GetMembers exchange; require an advertised leader URL",
    "Consume caller endpoint options in order on cached construction in both clients; verify resulting user-agent at real RPCs",
    "Share Go configured-scheme leader URL selection and transport security; remove stale plaintext-only discovery rejection; native region selection uses the same owner, and TSO proxy probing retains all advertised URLs",
    "All three etcd-client connection paths strip either advertised scheme and preserve the authority before applying security options",
    "Use the static forced-PD TSO provider in API mode at bootstrap and refresh, retaining provider-based GetMinTS semantics"
  ],
  "removals": [
    "Redundant native leader membership exchange and reachability precondition",
    "Separate adapter lazy-channel constructor without options",
    "Obsolete reachability-based alias fallback assertion, replaced with configured URL selection and stream reuse",
    "Stale plaintext-only discovery rejection; retain invalid-scheme rejection and verify configured transport security"
  ],
