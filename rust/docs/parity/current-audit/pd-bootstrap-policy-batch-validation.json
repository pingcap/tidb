  "date": "2026-10-06",
  "scope": "B01/B05: P03/P06/N03 lazy discovery connections, accepted membership, endpoint options and forced PD timestamp provider",
  "baseline": {
    "tidb": "0164d0cddb94258bbc363d9e02ece83d739705c0",
    "native": "35395ca53dcf219ee26b69367a5a6e2f19fd8748",
    "go_master": "3ca96b1d5df8da123e7a650512654eedab12c861",
