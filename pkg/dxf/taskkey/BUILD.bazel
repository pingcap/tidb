load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "taskkey",
    srcs = [
        "backfill.go",
        "import.go",
    ],
    importpath = "github.com/pingcap/tidb/pkg/dxf/taskkey",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config/kerneltype",
        "//pkg/dxf/framework/proto",
        "//pkg/keyspace",
        "//pkg/meta/model",
    ],
)

go_test(
    name = "taskkey_test",
    timeout = "short",
    srcs = ["task_key_test.go"],
    embed = [":taskkey"],
    flaky = True,
    deps = [
        "//pkg/config",
        "//pkg/config/kerneltype",
        "//pkg/meta/model",
        "@com_github_stretchr_testify//require",
    ],
)
