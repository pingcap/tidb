load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "masking",
    srcs = ["codec.go"],
    importpath = "github.com/pingcap/tidb/pkg/meta/masking",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/meta/model",
        "//pkg/parser/ast",
        "//pkg/util/chunk",
        "@com_github_pingcap_errors//:errors",
    ],
)

go_test(
    name = "masking_test",
    timeout = "short",
    srcs = ["codec_test.go"],
    embed = [":masking"],
    flaky = True,
    deps = [
        "//pkg/parser/mysql",
        "//pkg/types",
        "//pkg/util/chunk",
        "@com_github_stretchr_testify//require",
    ],
)
