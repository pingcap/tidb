load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "resultset",
    srcs = [
        "cursor.go",
        "resultset.go",
    ],
    importpath = "github.com/pingcap/tidb/pkg/server/internal/resultset",
    visibility = ["//pkg/server:__subpackages__"],
    deps = [
        "//pkg/parser/terror",
        "//pkg/planner/core",
