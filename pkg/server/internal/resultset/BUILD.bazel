go_test(
    name = "resultset_test",
    timeout = "short",
    srcs = ["cursor_test.go"],
    embed = [":resultset"],
    flaky = True,
    deps = [
        "//pkg/parser/mysql",
        "//pkg/types",
        "//pkg/util/chunk",
        "@com_github_stretchr_testify//require",
    ],
