load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packetio",
    srcs = ["packetio.go"],
    importpath = "github.com/pingcap/tidb/pkg/server/internal/packetio",
    visibility = ["//pkg/server:__subpackages__"],
    deps = [
        "//pkg/config",
        "//pkg/parser/mysql",
        "//pkg/parser/terror",
        "//pkg/server/err",
        "//pkg/server/internal/util",
        "//pkg/server/metrics",
        "@com_github_klauspost_compress//zlib",
        "@com_github_klauspost_compress//zstd",
        "@com_github_pingcap_errors//:errors",
    ],
)

go_test(
    name = "packetio_test",
    timeout = "short",
    srcs = ["packetio_test.go"],
    embed = [":packetio"],
    flaky = True,
    shard_count = 23,
    deps = [
        "//pkg/parser/mysql",
        "//pkg/server/err",
        "//pkg/server/internal/testutil",
        "//pkg/server/internal/util",
        "//pkg/util/israce",
        "@com_github_klauspost_compress//zstd",
        "@com_github_stretchr_testify//require",
    ],
)
