load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "diagnosticmode",
    srcs = [
        "doc.go",
        "mode.go",
    ],
    importpath = "github.com/pingcap/tidb/pkg/config/diagnosticmode",
    visibility = ["//visibility:public"],
    deps = ["//pkg/util/intest"],
)

go_test(
    name = "diagnosticmode_test",
    timeout = "short",
    srcs = [
        "mode_server_test.go",
        "mode_test.go",
    ],
    embed = [":diagnosticmode"],
    flaky = True,
    shard_count = 4,
    deps = [
        "//pkg/config",
        "//pkg/config/kerneltype",
        "//pkg/kv",
        "//pkg/meta",
        "//pkg/server",
        "//pkg/session",
        "//pkg/session/sessionapi",
        "//pkg/sessionctx/vardef",
        "//pkg/store/mockstore",
        "//pkg/testkit/testenv",
        "//pkg/testkit/testsetup",
        "//pkg/util/intest",
        "@com_github_stretchr_testify//require",
        "@io_opencensus_go//stats/view",
    ],
)
