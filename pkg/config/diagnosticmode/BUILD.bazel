load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "diagnosticmode",
    srcs = [
        "doc.go",
        "mode.go",
    ],
    importpath = "github.com/pingcap/tidb/pkg/config/diagnosticmode",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/util/intest",
        "@com_github_pingcap_errors//:errors",
    ],
)

go_test(
    name = "diagnosticmode_test",
    timeout = "short",
    srcs = ["mode_test.go"],
    embed = [":diagnosticmode"],
    flaky = True,
    shard_count = 2,
    deps = [
        "//pkg/util/intest",
        "@com_github_stretchr_testify//require",
    ],
)
