load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hint",
    srcs = [
        "hint.go",
        "hint_processor.go",
        "hint_query_block.go",
    ],
    importpath = "github.com/pingcap/tidb/pkg/util/hint",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/errno",
        "//pkg/meta/model",
        "//pkg/parser",
        "//pkg/parser/ast",
        "//pkg/parser/format",
        "//pkg/types",
        "//pkg/util/dbterror",
        "//pkg/util/dbterror/plannererrors",
        "//pkg/util/logutil",
        "@com_github_pingcap_errors//:errors",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "hint_test",
    timeout = "short",
    srcs = ["hint_test.go"],
    embed = [":hint"],
    flaky = True,
    deps = [
        "//pkg/parser",
        "//pkg/parser/mysql",
        "@com_github_stretchr_testify//require",
    ],
)
