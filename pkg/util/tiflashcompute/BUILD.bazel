load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tiflashcompute",
    srcs = [
        "dispatch_policy.go",
        "topo_fetcher.go",
    ],
    importpath = "github.com/pingcap/tidb/pkg/util/tiflashcompute",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/config",
        "//pkg/errno",
        "//pkg/sessionctx/vardef",
        "//pkg/util/dbterror",
        "//pkg/util/logutil",
        "@com_github_pingcap_errors//:errors",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "tiflashcompute_test",
    timeout = "short",
    srcs = ["topo_fetcher_test.go"],
    embed = [":tiflashcompute"],
    flaky = True,
    deps = ["@com_github_stretchr_testify//require"],
)
