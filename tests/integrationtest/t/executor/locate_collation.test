create table locate_source(id int primary key, s varchar(20) collate utf8mb4_0900_ai_ci);
insert into locate_source values(1,'é'),(2,'É'),(3,'e'),(4,'café'),(5,'CAFE'),(6,'xéx'),(7,'xyz');
create table locate_scalar like locate_source;
create table locate_vector like locate_source;
insert into locate_scalar select * from locate_source;
insert into locate_vector select * from locate_source;
set tidb_enable_vectorized_expression=0;
select id,locate('e',s),locate('e',s,2) from locate_scalar order by id;
delete from locate_scalar where locate('e',s)=0;
select id from locate_scalar order by id;
set tidb_enable_vectorized_expression=1;
select id,locate('e',s),locate('e',s,2) from locate_vector order by id;
delete from locate_vector where locate('e',s)=0;
select id from locate_vector order by id;
drop table locate_source, locate_scalar, locate_vector;
set tidb_enable_vectorized_expression=default;
create table locate_boundaries(id int primary key, sub varchar(10) collate utf8mb4_general_ci, s varchar(20) collate utf8mb4_general_ci);
insert into locate_boundaries values (1,'䄀','AA'),(2,'䄀','AA䄀'),(3,'䄀','䄀AA'),(4,'䄀','AAAA');
set tidb_enable_vectorized_expression=0;
select id,locate(sub,s),locate(sub,s,2) from locate_boundaries order by id;
set tidb_enable_vectorized_expression=1;
select id,locate(sub,s),locate(sub,s,2) from locate_boundaries order by id;
drop table locate_boundaries;
set tidb_enable_vectorized_expression=default;
create table locate_ignorables(id int primary key, sub varchar(10) collate utf8mb4_0900_ai_ci, s varchar(20) collate utf8mb4_0900_ai_ci);
insert into locate_ignorables values (1,'⁄',concat('¼',convert(0x00 using utf8mb4),'⁄')),(2,'⁄',concat('¼',convert(0x0000 using utf8mb4),'⁄')),(3,'⁄',concat(convert(0x00 using utf8mb4),'⁄')),(4,concat(convert(0x00 using utf8mb4),'⁄'),concat(convert(0x00 using utf8mb4),'⁄')),(5,'⁄',concat('¼',convert(0x00 using utf8mb4))),(6,'',concat('¼',convert(0x00 using utf8mb4),'⁄'));
set tidb_enable_vectorized_expression=0;
select id,locate(sub,s),locate(sub,s,2) from locate_ignorables order by id;
set tidb_enable_vectorized_expression=1;
select id,locate(sub,s),locate(sub,s,2) from locate_ignorables order by id;
drop table locate_ignorables;
set tidb_enable_vectorized_expression=default;
