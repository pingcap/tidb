drop table if exists minmax_count_params;
create table minmax_count_params(a int);
insert into minmax_count_params values (1),(2);
set @@tidb_hashagg_partial_concurrency=4;
set @@tidb_hashagg_final_concurrency=4;
prepare s from 'select max_count(?), min_count(?) from minmax_count_params';
set @pv=5;
execute s using @pv,@pv;
set @pv=8;
execute s using @pv,@pv;
set @pv='abc';
execute s using @pv,@pv;
set @pv=null;
execute s using @pv,@pv;
deallocate prepare s;
prepare s from 'select 1 from minmax_count_params having max_count(?) > 0 and min_count(?) > 0';
set @pv=5;
execute s using @pv,@pv;
set @pv=null;
execute s using @pv,@pv;
deallocate prepare s;
drop table minmax_count_params;
set @@tidb_hashagg_partial_concurrency=default;
set @@tidb_hashagg_final_concurrency=default;
