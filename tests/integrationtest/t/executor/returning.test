# Test RETURNING clause support
# See https://github.com/pingcap/tidb/issues/58939

# Create test table
drop table if exists t;
create table t (id int auto_increment primary key, name varchar(20), val int default 10);

# ===========================================
# INSERT RETURNING tests (fully supported)
# ===========================================

# Test INSERT RETURNING *
insert into t (name) values ('alice') returning *;

# Test INSERT RETURNING specific columns
insert into t (name, val) values ('bob', 20) returning id, name;

# Test INSERT RETURNING with expression
insert into t (name, val) values ('charlie', 30) returning id, val + 1 as val_plus_one;

# Test INSERT RETURNING with MariaDB-style select expressions
drop table if exists t2;
create table t2 (id int, animal varchar(20));
insert into t2(id, animal) values (1, 'Dog'), (2, 'Lion'), (3, 'Tiger'), (4, 'Leopard') returning id, id + id, id & id, id || id;
drop table t2;

# Test INSERT RETURNING with default value
insert into t (name) values ('dave') returning id, val;

# Test multi-row INSERT RETURNING
insert into t (name, val) values ('eve', 50), ('frank', 60) returning id, name, val;

# Test INSERT ... SET RETURNING
insert into t set name = 'gina', val = 70 returning id, name, val;

# Test INSERT ... SELECT RETURNING
insert into t (name, val) select 'henry', 80 returning id, name, val;

# Test INSERT IGNORE RETURNING
insert into t (id, name, val) values (200, 'dup', 1);
insert ignore into t (id, name, val) values (200, 'dup2', 2), (201, 'ok', 3) returning id, name;

# Test INSERT IGNORE RETURNING where every row is skipped: MariaDB returns an empty
# result set and reports the duplicate as a warning.
insert ignore into t (id, name, val) values (200, 'dup3', 4) returning id, name;
show warnings;

# Test INSERT ... ON DUPLICATE KEY UPDATE RETURNING
insert into t (id, name, val) values (300, 'orig', 1);
insert into t (id, name, val) values (300, 'updated', 5) on duplicate key update name=values(name), val=values(val)+1 returning id, name, val;

# Test INSERT ... ON DUPLICATE KEY UPDATE RETURNING where the update changes nothing:
# the row is still returned, with the values it holds after the statement.
insert into t (id, name, val) values (300, 'updated', 5) on duplicate key update val = if(values(val) > val, values(val), val) returning id, name, val;

# Test INSERT ... ON DUPLICATE KEY UPDATE RETURNING with a table qualifier
insert into t (id, name, val) values (300, 'ignored', 1) on duplicate key update name = 'qualified' returning t.*;

# Test INSERT RETURNING with AUTO_RANDOM primary key
drop table if exists t_auto_random_returning;
create table t_auto_random_returning (id bigint primary key auto_random(3), name varchar(20));
insert into t_auto_random_returning (name) values ('auto-random-1'), ('auto-random-2') returning id > 0 as generated_id, name;
select count(*), count(distinct id), min(id > 0), max(id > 0) from t_auto_random_returning;
drop table t_auto_random_returning;

# Test INSERT RETURNING _tidb_rowid on NONCLUSTERED primary key
drop table if exists t_nonclustered_returning;
create table t_nonclustered_returning (id int, name varchar(20), primary key(id) nonclustered);
insert into t_nonclustered_returning values (1, 'nonclustered-1'), (2, 'nonclustered-2') returning id, name, _tidb_rowid;
# _tidb_rowid is not part of `*`.
insert into t_nonclustered_returning values (3, 'nonclustered-3') returning *;
drop table t_nonclustered_returning;

# Test INSERT RETURNING _tidb_rowid with SHARD_ROW_ID_BITS
drop table if exists t_shard_rowid_returning;
create table t_shard_rowid_returning (id int, name varchar(20), primary key(id) nonclustered) shard_row_id_bits=4;
--replace_column 2 <sharded_rowid>
insert into t_shard_rowid_returning values (1, 'shard-1'), (2, 'shard-2'), (3, 'shard-3') returning id, _tidb_rowid, ((1 << (64 - 4 - 1)) - 1) & _tidb_rowid as rowid_sequence;
drop table t_shard_rowid_returning;

# Test INSERT RETURNING on a table with an expression index: the hidden column that backs
# the index is not part of `*`.
drop table if exists t_hidden_returning;
create table t_hidden_returning (id int primary key, name varchar(20), key idx((lower(name))));
insert into t_hidden_returning values (1, 'Hidden') returning *;
drop table t_hidden_returning;

# Verify all rows were inserted correctly
select * from t order by id;

# ===========================================
# RETURNING in a pessimistic transaction
# ===========================================

begin pessimistic;
insert into t (name, val) values ('pessimistic', 90) returning name, val;
commit;
select name, val from t where name = 'pessimistic';

set @@tidb_constraint_check_in_place_pessimistic = off;
begin pessimistic;
insert into t (name, val) values ('lazy-check', 91) returning name, val;
commit;
select name, val from t where name = 'lazy-check';
set @@tidb_constraint_check_in_place_pessimistic = default;

# ===========================================
# Foreign keys are still checked
# ===========================================

drop table if exists fk_child_returning;
drop table if exists fk_parent_returning;
create table fk_parent_returning (id int primary key);
create table fk_child_returning (id int primary key, pid int, key(pid), constraint fk_child_parent_returning foreign key(pid) references fk_parent_returning(id));
insert into fk_parent_returning values (1) returning id;

--error 1452
insert into fk_child_returning values (1, 42) returning id, pid;
select * from fk_child_returning;

insert into fk_child_returning values (1, 1) returning id, pid;
select * from fk_child_returning;

# The foreign key is checked by EXPLAIN ANALYZE too.
--error 1452
explain analyze insert into fk_child_returning values (2, 43) returning id, pid;
select * from fk_child_returning;

drop table fk_child_returning;
drop table fk_parent_returning;

# ===========================================
# EXPLAIN / EXPLAIN ANALYZE
# ===========================================

drop table if exists t_explain_returning;
create table t_explain_returning (id int primary key, val int);

# EXPLAIN does not execute the statement.
--replace_column 2 <est_rows> 3 <task> 4 <access_object> 5 <operator_info>
explain insert into t_explain_returning values (1, 1) returning id;
select count(*) from t_explain_returning;

# EXPLAIN ANALYZE does execute it, and does not report the RETURNING rows.
--replace_column 2 <est_rows> 3 <actRows> 4 <task> 5 <access_object> 6 <execution_info> 7 <operator_info> 8 <memory> 9 <disk>
explain analyze insert into t_explain_returning values (2, 2) returning id;
select count(*) from t_explain_returning;
drop table t_explain_returning;

# ===========================================
# Prepared statements and the plan cache
# ===========================================

set @@tidb_enable_prepared_plan_cache = on;
drop table if exists t_prepared_returning;
create table t_prepared_returning (id int primary key, val int);
prepare st from 'insert into t_prepared_returning values (?, ?) returning id, val + 1';
set @id = 1, @val = 10;
execute st using @id, @val;
set @id = 2, @val = 20;
execute st using @id, @val;
select @@last_plan_from_cache;
deallocate prepare st;
drop table t_prepared_returning;
set @@tidb_enable_prepared_plan_cache = default;

# ===========================================
# Rejected RETURNING expressions
# ===========================================

# Unknown table qualifier in the wildcard.
--error 1051
insert into t (name) values ('bad-qualifier') returning bad.*;

# Unknown column.
--error 1054
insert into t (name) values ('bad-column') returning no_such_column;

# Aggregate and window functions cannot be evaluated over a single written row.
--error 1111
insert into t (name) values ('aggregate') returning max(id);

--error 3593
insert into t (name) values ('window') returning row_number() over ();

# Subqueries are rejected: an uncorrelated one would report the table as it was before the
# insert, and a correlated one cannot be evaluated over a written row.
--error 1235
insert into t (name) values ('subquery') returning (select id from t limit 1);

--error 1235
insert into t (name) values ('subquery') returning (select 1 + 1);

# Expressions over the written row are fine.
insert into t (name) values ('expression') returning name, val * 2 as double_val, upper(name);

# INSERT ... SELECT resolves RETURNING against the target table, not the source.
drop table if exists t_source_returning;
create table t_source_returning (src_id int, src_name varchar(20));
insert into t_source_returning values (1, 'source');
--error 1054
insert into t (name) select s.src_name from t_source_returning s returning src_id;
insert into t (name) select s.src_name from t_source_returning s returning name;

# RETURNING is an unreserved keyword, so after an unaliased table reference the parser
# reads it as a table alias. Spell the source with an alias, or parenthesise the SELECT.
--error 1064
insert into t (name) select src_name from t_source_returning returning name;
insert into t (name) (select src_name from t_source_returning) returning name;
drop table t_source_returning;

# REPLACE ... RETURNING is not part of the grammar.
--error 1064
replace into t (id, name) values (1, 'replaced') returning id;

# ===========================================
# Statements that must not write are still rejected
# ===========================================

set @@tidb_low_resolution_tso = on;
--error 1105
insert into t (name) values ('low-resolution') returning id;
set @@tidb_low_resolution_tso = default;

# ===========================================
# UPDATE RETURNING tests (not supported yet)
# ===========================================

--error 1235
update t set val = val + 1 returning *;

--error 1235
update t set val = 100 where id = 1 returning id, val;

# Multi-table UPDATE is rejected as well.
drop table if exists t_multi_returning;
create table t_multi_returning (id int primary key, val int);
--error 1235
update t, t_multi_returning set t.val = 1 where t.id = t_multi_returning.id returning t.id;
drop table t_multi_returning;

# ===========================================
# DELETE RETURNING tests (not supported yet)
# ===========================================

--error 1235
delete from t returning *;

--error 1235
delete from t where id = 1 returning id, name;

# Clean up
drop table t;
