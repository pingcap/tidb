# TestMaterializedViewAvgRefresh

use test;

drop materialized view if exists mv_avg_e2e;
drop table if exists t_mv_avg_e2e;

create table t_mv_avg_e2e (a int not null, b int);
insert into t_mv_avg_e2e values (1, 1), (1, 2), (2, null);
create materialized view log on t_mv_avg_e2e (a, b) purge next date_add(now(), interval 1 hour);

set @@session.div_precision_increment = 4;
create materialized view mv_avg_e2e (a, cnt_all, avg_b, cnt_b, sum_b) refresh fast next date_add(now(), interval 1 hour) as
select a, count(*), avg(b), count(b), sum(b) from t_mv_avg_e2e group by a;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;

# FAST refresh must use updated SUM/COUNT state and preserve the definition-time DPI.
set @@session.div_precision_increment = 0;
insert into t_mv_avg_e2e values (1, 4), (2, null), (3, 10);
delete from t_mv_avg_e2e where a = 1 and b = 1;
refresh materialized view mv_avg_e2e fast;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;

# A group with only NULL AVG inputs remains materialized while COUNT(*) is positive.
delete from t_mv_avg_e2e where a = 2 and b is null limit 1;
refresh materialized view mv_avg_e2e fast;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;

# COMPLETE modes must produce the same AVG state.
update t_mv_avg_e2e set b = 8 where a = 1 and b = 2;
refresh materialized view mv_avg_e2e complete in place;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;

insert into t_mv_avg_e2e values (3, 14);
refresh materialized view mv_avg_e2e complete out of place;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;

delete from t_mv_avg_e2e where a = 2;
insert into t_mv_avg_e2e values (4, 9);
refresh materialized view mv_avg_e2e complete delta apply;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;

set @@session.div_precision_increment = 4;
drop materialized view mv_avg_e2e;
drop materialized view log on t_mv_avg_e2e;
drop table if exists t_mv_avg_e2e;

# FLOAT and DOUBLE AVG follow the existing approximate floating-point SUM semantics.
drop materialized view if exists mv_avg_real_e2e;
drop table if exists t_mv_avg_real_e2e;

create table t_mv_avg_real_e2e (id int primary key, a int not null, f float, d double);
insert into t_mv_avg_real_e2e values
    (1, 1, 1.1, 10.1), (2, 1, 2.2, 20.2), (3, 2, null, null);
create materialized view log on t_mv_avg_real_e2e (id, a, f, d) purge next date_add(now(), interval 1 hour);
create materialized view mv_avg_real_e2e
    (a, avg_f, sum_f, cnt_f, avg_d, sum_d, cnt_d, cnt_all)
    refresh fast as
select a, avg(f), sum(f), count(f), avg(d), sum(d), count(d), count(*)
from t_mv_avg_real_e2e group by a;
select a, round(avg_f, 4), round(sum_f, 4), cnt_f,
       round(avg_d, 4), round(sum_d, 4), cnt_d, cnt_all
from mv_avg_real_e2e order by a;

insert into t_mv_avg_real_e2e values (4, 1, 4.4, 40.4), (5, 2, null, null), (6, 3, 30.3, 300.3);
delete from t_mv_avg_real_e2e where id = 1;
refresh materialized view mv_avg_real_e2e fast;
select a, round(avg_f, 4), round(sum_f, 4), cnt_f,
       round(avg_d, 4), round(sum_d, 4), cnt_d, cnt_all
from mv_avg_real_e2e order by a;

update t_mv_avg_real_e2e set f = 8.8, d = 80.8 where id = 2;
refresh materialized view mv_avg_real_e2e fast;
select a, round(avg_f, 4), round(sum_f, 4), cnt_f,
       round(avg_d, 4), round(sum_d, 4), cnt_d, cnt_all
from mv_avg_real_e2e order by a;

drop materialized view mv_avg_real_e2e;
drop materialized view log on t_mv_avg_real_e2e;
drop table if exists t_mv_avg_real_e2e;
