# TestRefreshMaterializedViewTransactionValidation

use test;

create table t_mv_txn_66385 (a int not null, b int not null);
insert into t_mv_txn_66385 values (1, 10), (1, 5), (2, 7);
create materialized view log if not exists on t_mv_txn_66385 (a, b) purge next date_add(now(), interval 1 hour);
create materialized view log if not exists on t_mv_txn_66385 (a);
show warnings;
create materialized view if not exists mv_txn_66385 (a, s, cnt) refresh fast next date_add(now(), interval 1 hour) as
select a, sum(b), count(1) from t_mv_txn_66385 group by a;
create materialized view if not exists mv_txn_66385 (a, cnt) as
select a, count(1) from t_mv_txn_66385 group by a;
show warnings;

-- error 1105
refresh materialized view mv_txn_66385 with async mode complete in place;

begin;
-- error 1105
refresh materialized view mv_txn_66385 complete in place;
rollback;

prepare stmt from "refresh materialized view mv_txn_66385 complete in place";
begin;
-- error 1105
execute stmt;
rollback;
deallocate prepare stmt;

set autocommit = 0;
select @@tidb_current_ts = 0;
refresh materialized view mv_txn_66385 complete in place;
select @@tidb_current_ts = 0;

insert into t_mv_txn_66385 values (3, 4);
select @@tidb_current_ts > 0;
-- error 1105
refresh materialized view mv_txn_66385 complete in place;
rollback;

set autocommit = 1;

drop materialized view mv_txn_66385;
drop materialized view log on t_mv_txn_66385;
drop table if exists t_mv_txn_66385;

# TestRefreshMaterializedViewCompleteDeltaApply

create table t_mv_inc_67017 (a int not null, b int not null);
insert into t_mv_inc_67017 values (1, 10), (1, 5), (2, 7);
create materialized view log on t_mv_inc_67017 (a, b) purge next date_add(now(), interval 1 hour);
create materialized view mv_inc_67017 (a, s, cnt) refresh fast next date_add(now(), interval 1 hour) as
select a, sum(b), count(1) from t_mv_inc_67017 group by a;

select * from mv_inc_67017 order by a;
insert into t_mv_inc_67017 values (2, 3), (3, 4);
refresh materialized view mv_inc_67017 complete delta apply;
select * from mv_inc_67017 order by a;

drop materialized view mv_inc_67017;
drop materialized view log on t_mv_inc_67017;
drop table if exists t_mv_inc_67017;

# TestRefreshMaterializedViewWritesMLog

create table t_mv_mlog_refresh (a int not null, b int not null);
insert into t_mv_mlog_refresh values (1, 10), (1, 5), (2, 7);
create materialized view log on t_mv_mlog_refresh (a, b) purge next date_add(now(), interval 1 hour);
create materialized view mv_mlog_refresh (a, s, cnt) refresh fast as
select a, sum(b), count(1) from t_mv_mlog_refresh group by a;
create materialized view log on mv_mlog_refresh (a, s, cnt);

update t_mv_mlog_refresh set b = 11 where a = 1 and b = 10;
delete from t_mv_mlog_refresh where a = 2;
insert into t_mv_mlog_refresh values (3, 4);
refresh materialized view mv_mlog_refresh fast;

update t_mv_mlog_refresh set b = 12 where a = 1 and b = 11;
delete from t_mv_mlog_refresh where a = 3;
insert into t_mv_mlog_refresh values (4, 8);
refresh materialized view mv_mlog_refresh complete delta apply;

select a, s, cnt, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`
from `$mlog$mv_mlog_refresh`
order by a, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`, s;

drop materialized view log on mv_mlog_refresh;
drop materialized view mv_mlog_refresh;
drop materialized view log on t_mv_mlog_refresh;
drop table if exists t_mv_mlog_refresh;

# TestNestedMaterializedViewFastRefresh

create table t_nested_mv_refresh (a int not null, b int not null, v int not null);
insert into t_nested_mv_refresh values (1, 1, 10), (1, 1, 5), (1, 2, 7), (2, 1, 4);
create materialized view log on t_nested_mv_refresh (a, b, v);
create materialized view mv_nested_parent (a, b, s, cnt) refresh fast as
select a, b, sum(v), count(1) from t_nested_mv_refresh group by a, b;
create materialized view log on mv_nested_parent (a, b, s, cnt);
create materialized view mv_nested_child (a, s, cnt, cnt_s) refresh fast as
select a, sum(s), count(1), count(s) from mv_nested_parent group by a;

select a, s, cnt, cnt_s from mv_nested_child order by a;

update t_nested_mv_refresh set v = 11 where a = 1 and b = 1 and v = 10;
delete from t_nested_mv_refresh where a = 1 and b = 2;
insert into t_nested_mv_refresh values (3, 1, 8);
refresh materialized view mv_nested_parent fast;
refresh materialized view mv_nested_child fast;

select a, s, cnt, cnt_s from mv_nested_child order by a;

update t_nested_mv_refresh set v = 12 where a = 1 and b = 1 and v = 11;
delete from t_nested_mv_refresh where a = 3 and b = 1;
insert into t_nested_mv_refresh values (4, 1, 9);
refresh materialized view mv_nested_parent complete delta apply;
refresh materialized view mv_nested_child fast;

select a, s, cnt, cnt_s from mv_nested_child order by a;

drop materialized view mv_nested_child;
drop materialized view log on mv_nested_parent;
drop materialized view mv_nested_parent;
drop materialized view log on t_nested_mv_refresh;
drop table if exists t_nested_mv_refresh;

# TestMaterializedViewIndexDDLWritableColumns

create table t_mv_ddl_70457 (a int not null, b int not null);
insert into t_mv_ddl_70457 values (1, 10), (1, 5), (2, 7);
create materialized view log on t_mv_ddl_70457 (a, b) purge next date_add(now(), interval 1 hour);
create materialized view mv_ddl_70457 (a, s, cnt) refresh fast next date_add(now(), interval 1 hour) as
select a, sum(b), count(1) from t_mv_ddl_70457 group by a;

create index idx_a on mv_ddl_70457 (a);
drop index idx_a on mv_ddl_70457;

-- error 8200
create index idx_expr on mv_ddl_70457 ((a + 1));
-- error 8200
alter table mv_ddl_70457 add index idx_expr2 ((a + 1));
desc mv_ddl_70457;

drop materialized view mv_ddl_70457;
drop materialized view log on t_mv_ddl_70457;
drop table if exists t_mv_ddl_70457;

# TestDropMaterializedViewWithOwnedLog

create table t_mv_drop_owned_log (a int not null, b int not null);
insert into t_mv_drop_owned_log values (1, 10), (1, 5), (2, 7);
create materialized view log on t_mv_drop_owned_log (a, b);
create materialized view mv_drop_owned_log (a, s, cnt) as
select a, sum(b), count(1) from t_mv_drop_owned_log group by a;
create materialized view log on mv_drop_owned_log (a, s, cnt);
set @owned_mlog_id = (select mlog_id from information_schema.tidb_mlogs where table_schema = 'test' and mlog_name = '$mlog$mv_drop_owned_log');

-- error 8200
drop materialized view mv_drop_owned_log;
-- error 8200
drop materialized view if exists mv_drop_owned_log;
select * from mv_drop_owned_log order by a;
select mlog_name, base_table_name from information_schema.tidb_mlogs where mlog_id = @owned_mlog_id;
select count(*) from mysql.tidb_mlog_purge_info where mlog_id = @owned_mlog_id;

drop materialized view log on mv_drop_owned_log;
select count(*) from mysql.tidb_mlog_purge_info where mlog_id = @owned_mlog_id;
drop materialized view mv_drop_owned_log;
show tables like 'mv_drop_owned_log';
show tables like '$mlog$mv_drop_owned_log';
drop materialized view log on t_mv_drop_owned_log;
drop table t_mv_drop_owned_log;

# Input log registration, missing-record checks, and existing leaf OOP.

create table t_mv_source_info (a int not null, b int not null);
insert into t_mv_source_info values (1, 10), (2, 20);
create materialized view log on t_mv_source_info (a, b);
create materialized view mv_source_info (a, s, cnt) refresh fast as
select a, sum(b), count(*) from t_mv_source_info group by a;
set @source_mv_old_id = (select tidb_table_id from information_schema.tables where table_schema = 'test' and table_name = 'mv_source_info');
set @source_log_id = (select mlog_id from information_schema.tidb_mlogs where table_schema = 'test' and mlog_name = '$mlog$t_mv_source_info');
select MLOG_ID = @source_log_id as input_log_matches from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_old_id;

# Advisory-lock conflicts have a distinct SQL error code.
select get_lock(concat('mlog_purge_', @source_log_id), 0) as lock_acquired;
-- error 8182
purge materialized view log on t_mv_source_info;
select release_lock(concat('mlog_purge_', @source_log_id)) as lock_released;

insert into t_mv_source_info values (1, 5);
refresh materialized view mv_source_info fast;
select * from mv_source_info order by a;
select MLOG_ID = @source_log_id as input_log_matches from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_old_id;

# A nonempty but stale/incomplete registration requires COMPLETE recovery.
update mysql.tidb_mview_fast_refresh_source_info set MLOG_ID = 0 where MVIEW_ID = @source_mv_old_id;
insert into t_mv_source_info values (2, 3);
-- error 8183
refresh materialized view mv_source_info fast;
select * from mv_source_info order by a;
refresh materialized view mv_source_info complete delta apply;
select * from mv_source_info order by a;
select MLOG_ID = @source_log_id as input_log_matches from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_old_id;

insert into mysql.tidb_mview_fast_refresh_source_info values (@source_mv_old_id, -1);
-- error 8183
refresh materialized view mv_source_info fast;
refresh materialized view mv_source_info complete in place;
select count(*) from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_old_id;
update mysql.tidb_mview_fast_refresh_source_info set MLOG_ID = -1 where MVIEW_ID = @source_mv_old_id;
refresh materialized view mv_source_info complete out of place;
set @source_mv_new_id = (select tidb_table_id from information_schema.tables where table_schema = 'test' and table_name = 'mv_source_info');
select @source_mv_new_id <> @source_mv_old_id as target_replaced;
select count(*) from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_old_id;
select MLOG_ID = @source_log_id as input_log_matches from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_new_id;
delete from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_new_id;
-- error 1105
refresh materialized view mv_source_info fast;
select count(*) from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID = @source_mv_new_id;
drop materialized view mv_source_info;
select count(*) from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID in (@source_mv_old_id, @source_mv_new_id);
drop materialized view log on t_mv_source_info;
drop table t_mv_source_info;

# Parent OOP publishes a new output log and preserves child continuity markers.
create table t_oop_log (a int not null, b int not null);
insert into t_oop_log values (1, 10), (2, 20);
create materialized view log on t_oop_log (a, b);
create materialized view mv_oop_log (a, s, cnt) refresh fast as select a, sum(b), count(*) from t_oop_log group by a;
create materialized view log on mv_oop_log (a, s, cnt);
create materialized view mv_oop_child (a, s, cnt, cnt_s) refresh fast as select a, sum(s), count(*), count(s) from mv_oop_log group by a;
set @oop_old_mv = (select tidb_table_id from information_schema.tables where table_schema='test' and table_name='mv_oop_log');
set @oop_old_log = (select tidb_table_id from information_schema.tables where table_schema='test' and table_name='$mlog$mv_oop_log');
set @oop_child = (select tidb_table_id from information_schema.tables where table_schema='test' and table_name='mv_oop_child');
set @oop_child_tso = (select LAST_SUCCESS_READ_TSO from mysql.tidb_mview_refresh_info where MVIEW_ID=@oop_child);
insert into t_oop_log values (3, 30);
refresh materialized view mv_oop_log complete out of place;
set @oop_new_mv = (select tidb_table_id from information_schema.tables where table_schema='test' and table_name='mv_oop_log');
set @oop_new_log = (select tidb_table_id from information_schema.tables where table_schema='test' and table_name='$mlog$mv_oop_log');
select @oop_new_mv <> @oop_old_mv as mv_replaced, @oop_new_log <> @oop_old_log as log_replaced;
select * from mv_oop_log order by a;
select count(*) from `$mlog$mv_oop_log`;
select count(*) from mysql.tidb_mlog_purge_info where MLOG_ID=@oop_old_log;
select LAST_PURGED_TSO is null from mysql.tidb_mlog_purge_info where MLOG_ID=@oop_new_log;
select MLOG_ID=@oop_old_log as old_input_preserved from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID=@oop_child;
select LAST_SUCCESS_READ_TSO=@oop_child_tso as child_watermark_preserved from mysql.tidb_mview_refresh_info where MVIEW_ID=@oop_child;
-- error 8183
refresh materialized view mv_oop_child fast;
select * from mv_oop_child order by a;
insert into t_oop_log values (4, 40);
refresh materialized view mv_oop_log fast;
purge materialized view log on mv_oop_log;
select count(*) > 0 as child_protects_new_log from `$mlog$mv_oop_log`;
select LAST_PURGED_TSO=@oop_child_tso as child_watermark_protects_new_log from mysql.tidb_mlog_purge_info where MLOG_ID=@oop_new_log;
refresh materialized view mv_oop_child complete delta apply;
select MLOG_ID=@oop_new_log as input_recovered from mysql.tidb_mview_fast_refresh_source_info where MVIEW_ID=@oop_child;
insert into t_oop_log values (5, 50);
refresh materialized view mv_oop_log fast;
refresh materialized view mv_oop_child fast;
select * from mv_oop_child order by a;
drop materialized view mv_oop_child;
drop materialized view log on mv_oop_log;
drop materialized view mv_oop_log;
drop materialized view log on t_oop_log;
drop table t_oop_log;
