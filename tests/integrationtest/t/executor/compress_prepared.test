use test;
set tidb_enable_prepared_plan_cache=1;
drop table if exists compress_prepared;
create table compress_prepared (id int primary key, req_body mediumblob);
prepare stmt from 'insert into compress_prepared (id,req_body) values (?,compress(?))';
set @id=1;
set @payload='{"k":"v","payload":"MASKED_TEXT_ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"}';
execute stmt using @id,@payload;
select id,uncompress(req_body)=@payload from compress_prepared where id=1;
set @id=2;
set @payload=repeat('ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789',1000);
execute stmt using @id,@payload;
select @@last_plan_from_cache;
select id,uncompress(req_body)=@payload from compress_prepared where id=2;
set @id=3;
execute stmt using @id,@payload;
select @@last_plan_from_cache;
select id,uncompress(req_body)=@payload from compress_prepared where id=3;
deallocate prepare stmt;
drop table compress_prepared;
set tidb_enable_prepared_plan_cache=default;
