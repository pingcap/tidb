
create table t(a int, b int, c int);

INSERT INTO t (a, b, c) VALUES
(1, 1, 1),
(1, 2, 2),
(1, 3, 3),
(2, 1, 4),
(2, 2, 5),
(2, 3, 6),
(3, 1, 7),
(3, 2, 8),
(3, 3, 9),
(NULL, 1, 10),
(1, NULL, 11),
(1, 1, NULL),
(NULL, NULL, 12),
(4, 1, 13),
(4, 2, 14),
(4, 3, 15);

select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1) and (a > 2) and 1 and (b > 2) and (avg(c) > 3) order by a, b, avgc;

explain format='plan_tree' select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1) and (a > 2) and 1 and (b > 2) and (avg(c) > 3) order by a, b, avgc;

select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 or b > 2) and (a > 2 or b < 1) and 1 and (b > 2) and (avg(c) > 3) order by a, b, avgc;

explain format='plan_tree' select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 or b > 2) and (a > 2 or b < 1) and 1 and (b > 2) and (avg(c) > 3) order by a, b, avgc;

select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 and b > 2) or (a > 2 and b < 1) or (b > 2 and avg(c) > 3) order by a, b, avgc;

explain format='plan_tree' select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 and b > 2) or (a > 2 and b < 1) or (b > 2 and avg(c) > 3) order by a, b, avgc;

select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 or avg(c) > 1) and (a < 3) order by a, b, avgc;

explain format='plan_tree' select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 or avg(c) > 1) and (a < 3) order by a, b, avgc;

select a, b, avg(c) as avgc from t group by a, b, c having
(a > 1 and avg(c) > 1) or (a < 3) order by a, b, avgc;

explain format='plan_tree' select a, b, avg(c) as avgc from t group by a, b, c having

(a > 1 and avg(c) > 1) or (a < 3) order by a, b, avgc;

drop table t;
CREATE TABLE t (
    id INT,
    tran_id INT,
    PRIMARY KEY (id)
);

INSERT INTO t (id, tran_id) VALUES
(1, 1540776),
(2, 1540776),
(3, 1540776),
(4, 1540777),
(5, 1540777),
(6, 1540778),
(7, 1540778),
(8, 1540779),
(9, 1540779),
(10, 1540780),
(11, NULL),
(12, NULL),
(13, 1540776),
(14, 1540777),
(15, 1540778);


SELECT *
FROM t t1
WHERE t1.tran_id = 1540776
  AND t1.id = (
    SELECT MAX(t0.id)
    FROM t t0
    WHERE t0.tran_id = t1.tran_id
  );

explain format='brief' SELECT *
FROM t t1
WHERE t1.tran_id = 1540776
  AND t1.id = (
    SELECT MAX(t0.id)
    FROM t t0
    WHERE t0.tran_id = t1.tran_id
  );

# Issue #71738: a predicate on a firstrow() output must not be pushed below an aggregation
# that also computes other aggregates, unless it is constant within each group.
drop table if exists t1, t2;
create table t1(c1 int, c2 int);
create table t2(id int primary key, c1 int, c2 int, key idx(c1, c2));
insert into t1 values (1, 5);
insert into t2 values (1, 1, null), (2, 1, 20);
set @@sql_mode='';

# UNSAFE: c2 is not a grouping key and count(*) depends on every row -> keep the filter above the aggregation
explain format='plan_tree' select t1.c1, a.cnt from t1 join (select c1, c2, count(*) cnt from t2 group by c1) a on t1.c1 = a.c1 where a.c2 is not null;
select t1.c1, a.cnt from t1 join (select c1, c2, count(*) cnt from t2 group by c1) a on t1.c1 = a.c1 where a.c2 is not null;
explain format='plan_tree' select t1.c1, a.cnt from t1 join (select c1, c2, count(*) cnt from t2 group by c1) a on t1.c1 = a.c1 and a.c2 > t1.c2;
select t1.c1, a.cnt from t1 join (select c1, c2, count(*) cnt from t2 group by c1) a on t1.c1 = a.c1 and a.c2 > t1.c2;

# SAFE: all aggregates are firstrow() -> pushed down
explain format='plan_tree' select c1, c2 from (select c1, c2 from t2 group by c1) a where a.c2 is not null;
select c1, c2 from (select c1, c2 from t2 group by c1) a where a.c2 is not null;

# SAFE: the GROUP BY column (primary key) functionally determines c2 -> pushed down
explain format='plan_tree' select id, c2, cnt from (select id, c2, count(*) cnt from t2 group by id) a where a.c2 is not null;
select id, c2, cnt from (select id, c2, count(*) cnt from t2 group by id) a where a.c2 is not null;

# SAFE: the predicate only depends on the GROUP BY expression -> pushed down
explain format='plan_tree' select d, cnt from (select c1 + 1 d, count(*) cnt from t2 group by c1 + 1) a where a.d > 1;
select d, cnt from (select c1 + 1 d, count(*) cnt from t2 group by c1 + 1) a where a.d > 1;

set @@sql_mode=default;
drop table t1, t2;

# A predicate with mutable effects (RAND()) must stay above the aggregation even when the GROUP BY
# columns determine its columns: below the aggregation it would be evaluated per input row.
drop table if exists t3, t4;
create table t3(id int primary key, c1 int, c2 int);
create table t4(c1 int, v int);
explain format='plan_tree' select a.id, a.cnt from (select t3.id, t3.c2, count(*) cnt from t3 left join t4 on t3.c1 = t4.c1 group by t3.id) a where rand() < a.c2;
drop table t3, t4;
