# TestPreSplitIndexRegionsTimeZone
# A manual PRE_SPLIT_REGIONS value list is evaluated in the time zone of the session that submits
# the statement, so the index-key boundary must land on the instant that session named. It must not
# depend on the time zone of the DDL owner's internal session, which is what actually runs the job.
# Each pair below names the same instant from two different session time zones, so once the region
# and table identifiers are masked the two boundaries must come out byte-identical.
drop table if exists t_by_east, t_by_utc, t_between_east, t_between_utc;

--echo # How to read the END_KEY below. After the masked t_i_ prefix the bytes are the encoded
--echo # index value followed by the handle sentinel:
--echo #   04                  uint flag
--echo #   19b3102000000000    the TIMESTAMP, packed as
--echo #                       ((year*13+month)<<5 | day)<<17 | hour<<12 | minute<<6 | second,
--echo #                       shifted left 24 for microseconds, always in UTC
--echo #                       = 2024-04-08 02:00:00 UTC
--echo #   03 0000000000000000 int flag plus MinInt64, the sentinel handle used for a split key
--echo # So 2024-04-08 10:00:00 at +08:00 and 2024-04-08 02:00:00 at UTC must both encode to
--echo # 0419b3102000000000, and any other time zone applied to the value shows up as different bytes.

set @@session.time_zone = '+08:00';
create table t_by_east (a bigint, b timestamp);
alter table t_by_east add index idx(b) pre_split_regions = (by ('2024-04-08 10:00:00'));
--replace_column 1 # 4 # 5 # 6 # 7 # 8 # 9 # 10 # 11 #
--replace_regex /t_[0-9]+_i_[0-9]+_/t_i_/ /t_[0-9]+_/t_/
show table t_by_east index idx regions;

set @@session.time_zone = 'UTC';
create table t_by_utc (a bigint, b timestamp);
alter table t_by_utc add index idx(b) pre_split_regions = (by ('2024-04-08 02:00:00'));
--replace_column 1 # 4 # 5 # 6 # 7 # 8 # 9 # 10 # 11 #
--replace_regex /t_[0-9]+_i_[0-9]+_/t_i_/ /t_[0-9]+_/t_/
show table t_by_utc index idx regions;

# The BETWEEN form builds its keys through the same encoder.
--echo # A BETWEEN key is built differently: the common prefix of the two bound keys plus one
--echo # 8-byte interpolated value, so it is shorter than a whole index key. The bounds here are
--echo # 02:00:00 and 06:00:00 UTC over 4 regions, so the first boundary is one hour in and its
--echo # leading bytes still read as 0419b3103000000000 = 2024-04-08 03:00:00 UTC; the trailing
--echo # 030000 is what is left of the handle after the interpolation, not a complete one.
set @@session.time_zone = '+08:00';
create table t_between_east (a bigint, b timestamp);
alter table t_between_east add index idx(b) pre_split_regions = (between ('2024-04-08 10:00:00') and ('2024-04-08 14:00:00') regions 4);
--replace_column 1 # 4 # 5 # 6 # 7 # 8 # 9 # 10 # 11 #
--replace_regex /t_[0-9]+_i_[0-9]+_/t_i_/ /t_[0-9]+_/t_/
show table t_between_east index idx regions;

set @@session.time_zone = 'UTC';
create table t_between_utc (a bigint, b timestamp);
alter table t_between_utc add index idx(b) pre_split_regions = (between ('2024-04-08 02:00:00') and ('2024-04-08 06:00:00') regions 4);
--replace_column 1 # 4 # 5 # 6 # 7 # 8 # 9 # 10 # 11 #
--replace_regex /t_[0-9]+_i_[0-9]+_/t_i_/ /t_[0-9]+_/t_/
show table t_between_utc index idx regions;

set @@session.time_zone = default;
drop table if exists t_by_east, t_by_utc, t_between_east, t_between_utc;
