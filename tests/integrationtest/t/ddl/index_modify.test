# TestAddMultiColumnsIndexClusterIndex
set tidb_enable_clustered_index = ON;
drop table if exists t;
create table t (a int, b varchar(10), c int, primary key (a, b));
insert into t values (1, '1', 1), (2, '2', NULL), (3, '3', 3);
create index idx on t (a, c);
admin check index t idx;
admin check table t;
insert into t values (5, '5', 5), (6, '6', NULL);
admin check index t idx;
admin check table t;
set tidb_enable_clustered_index = default;

# TestAddIndexWithDupCols
drop table if exists test_add_index_with_dup;
create table test_add_index_with_dup (a int, b int);
-- error 1060
create index c on test_add_index_with_dup(b, a, b);
-- error 1060
create index c on test_add_index_with_dup(b, a, B);
-- error 1060
alter table test_add_index_with_dup add index c (b, a, b);
-- error 1060
alter table test_add_index_with_dup add index c (b, a, B);
drop table test_add_index_with_dup;

# TestAddIndexRestoreData
set global tidb_ddl_enable_fast_reorg=true;
drop table if exists test_add_index_restore_data;
create table test_add_index_restore_data (a char(100) NOT NULL primary key, b int) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
insert test_add_index_restore_data value('abc', 0);
alter table test_add_index_restore_data add index idx(b);
select a from test_add_index_restore_data use index(idx);
admin check table test_add_index_restore_data;

drop table if exists test_add_index_restore_data;
create table test_add_index_restore_data (a char(100), b int NOT NULL primary key) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
insert test_add_index_restore_data value('abc', 0);
alter table test_add_index_restore_data add index idx(b);
select a from test_add_index_restore_data use index(idx);
admin check table test_add_index_restore_data;

drop table if exists test_add_index_restore_data;
create table test_add_index_restore_data (a char(100) NOT NULL, b date NOT NULL DEFAULT '2005-02-12', c int, primary key(a, b)) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
insert test_add_index_restore_data value('abc', '1972-11-10', 0);
alter table test_add_index_restore_data add index idx(c);
select a from test_add_index_restore_data use index(idx);
admin check table test_add_index_restore_data;

drop table if exists test_add_index_restore_data;
set global tidb_ddl_enable_fast_reorg=default;

# FULLTEXT index on the classic kernel, materialised as a multi-valued index
# over a hidden tokenized column.
drop table if exists fts_articles;
create table fts_articles (id int primary key, body varchar(255));
insert into fts_articles values (1, 'distributed sql database'), (2, 'relational storage engine');
alter table fts_articles add fulltext index idx_body (body);
insert into fts_articles values (3, 'distributed storage layer');
admin check table fts_articles;

# The tokenized column is hidden, so it must not appear in the row or the
# column list.
select * from fts_articles order by id;
show columns from fts_articles;

# The index is reported as it was declared, not as the rewritten expression.
show create table fts_articles;

# The index carries real entries for rows added by backfill and by later writes.
select id from fts_articles use index (idx_body) order by id;

# An inline FULLTEXT KEY is rewritten too, so the definition above can be
# pasted back to recreate the table.
drop table if exists fts_inline;
create table fts_inline (id int primary key, body varchar(255), fulltext key idx_body (body));
show create table fts_inline;
insert into fts_inline values (1, 'distributed sql');
admin check table fts_inline;

# A non-default parser is recorded and reported.
drop table if exists fts_ngram;
create table fts_ngram (id int primary key, body varchar(255));
alter table fts_ngram add fulltext index idx_body (body) with parser ngram;
show create table fts_ngram;

# An ordinary multi-valued index is unaffected by the FULLTEXT rendering.
drop table if exists mv_plain;
create table mv_plain (id int primary key, j json, key idx((cast(j->'$.tags' as char(20) array))));
show create table mv_plain;

-- error 8200
alter table fts_articles add fulltext index idx_bad (id);

drop table if exists fts_articles, fts_inline, fts_ngram, mv_plain;
