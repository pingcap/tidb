# The session-token rollout phase is persisted globally and never migrates as a session override.
select @@global.tidb_session_token_mode;
-- error 1229
set session tidb_session_token_mode='STRICT';
-- error 1231
set global tidb_session_token_mode='invalid';
set global tidb_session_token_mode='transition';
select @@global.tidb_session_token_mode;
select variable_value from mysql.global_variables where variable_name='tidb_session_token_mode';
set global tidb_session_token_mode='strict';
select @@global.tidb_session_token_mode;
set global tidb_session_token_mode=default;
select @@global.tidb_session_token_mode;
