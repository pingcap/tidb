# Every geospatial function name in the parser's ast package, one statement each: the ones
# MySQL 9.7.2 has, TiDB's EWKB pair and the geospatial index functions. A function TiDB
# does not have raises 1305, as any unknown function does. The arguments are NULL, at least
# as many as MySQL requires.

# === Constructors ===
--error 1305
select Point(NULL, NULL);
--error 1305
select LineString(NULL);
--error 1305
select Polygon(NULL);
--error 1305
select MultiPoint(NULL);
--error 1305
select MultiLineString(NULL);
--error 1305
select MultiPolygon(NULL);
--error 1305
select GeometryCollection(NULL);
--error 1305
select GeomCollection(NULL);

