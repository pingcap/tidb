# Every geospatial function name in the parser's ast package, one statement each: the ones
# MySQL 9.7.2 has, the ones beyond MySQL that SQL/MM Part 3 defines, and TiDB's own: the
# EWKB and EWKT pairs, the Z, M, linear-referencing and trajectory functions, the relations
# a geospatial index can serve, the PostGIS spellings TiDB Cloud Lake also has, and further
# measurement and processing, as PostGIS names them, and the geospatial index functions. A
# function TiDB does not have raises 1305, as any unknown function does. The arguments are
# NULL, at least as many as MySQL, or for a function MySQL lacks PostGIS, or else the
# shortest SQL/MM form, requires.

# === Constructors ===
--error 1305
select Point(NULL, NULL);
--error 1305
select LineString(NULL);
--error 1305
select Polygon(NULL);
--error 1305
select MultiPoint(NULL);
--error 1305
select MultiLineString(NULL);
--error 1305
select MultiPolygon(NULL);
--error 1305
select GeometryCollection(NULL);
--error 1305
select GeomCollection(NULL);

