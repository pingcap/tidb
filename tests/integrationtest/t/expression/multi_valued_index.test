# TestMultiValuedIndexInCompoundIndex
drop table if exists t;
create table t (j json not null, str varchar(5),  KEY `idx` ((cast(`j` as unsigned array)),`str`));
insert into t values ('1', 'abcde');
drop table t;
create table t (j json not null, str varchar(5) collate utf8mb4_unicode_ci,  KEY `idx` ((cast(`j` as unsigned array)),`str`));
insert into t values ('1', 'abcde');
drop table t;
create table t (j json not null, str varchar(5) collate gbk_chinese_ci,  KEY `idx` ((cast(`j` as unsigned array)),`str`));
insert into t values ('1', 'abcde');
drop table t;

# TestTiDBJSONFlattenMultiValuedIndex
select tidb_json_flatten(null), tidb_json_flatten('{}'), tidb_json_flatten('[]'), tidb_json_flatten('"x"');
select tidb_json_flatten('{"cells":{"ccf_1":{"state":"error","errorCode":[1,7,7.0]},"ccf_2":{"state":"results","v":"7"}}}');
select tidb_json_flatten('{"a.b":1,"x":{},"y":[[1,{"z":true}]],"n":null}');
drop table if exists t;
create table t (id bigint primary key, wb_id int not null default 1, meta json,
  index idx_meta ((cast(tidb_json_flatten(meta) as char(256) array))),
  index idx_wb_meta (wb_id, (cast(tidb_json_flatten(meta) as char(256) array))));
insert into t (id, meta) values
 (1, '{"cells":{"ccf_1":{"state":"error","errorCode":[1,2]},"ccf_2":{"state":"results","errorCode":[]}}}'),
 (2, '{"cells":{"ccf_1":{"state":"results","errorCode":[]},"ccf_3":{"state":"error","errorCode":[7]}}}'),
 (3, '{"cells":{"ccf_3":{"state":"error","errorCode":[7,9]}}}'),
 (4, '{"cells":{}}'),
 (5, '{}'),
 (6, null);
explain format='brief' select id from t use index(idx_meta) where '$.cells.ccf_1.state="error"' member of (tidb_json_flatten(meta));
select id from t use index(idx_meta) where '$.cells.ccf_1.state="error"' member of (tidb_json_flatten(meta)) order by id;
select id from t use index(idx_meta) where '$.cells.ccf_3.errorCode=7' member of (tidb_json_flatten(meta)) order by id;
select id from t use index(idx_meta) where '$.cells.ccf_1.errorCode=7' member of (tidb_json_flatten(meta)) order by id;
explain format='brief' select id from t use index(idx_meta) where json_overlaps(tidb_json_flatten(meta), '["$.cells.ccf_1.state=\\"error\\"","$.cells.ccf_3.state=\\"error\\""]');
select id from t use index(idx_meta) where json_overlaps(tidb_json_flatten(meta), '["$.cells.ccf_1.state=\\"error\\"","$.cells.ccf_3.state=\\"error\\""]') order by id;
explain format='brief' select id from t use index(idx_meta) where json_contains(tidb_json_flatten(meta), '["$.cells.ccf_3.state=\\"error\\"","$.cells.ccf_3.errorCode=9"]');
select id from t use index(idx_meta) where json_contains(tidb_json_flatten(meta), '["$.cells.ccf_3.state=\\"error\\"","$.cells.ccf_3.errorCode=9"]') order by id;
explain format='brief' select id from t use index(idx_wb_meta) where wb_id = 1 and '$.cells.ccf_3.errorCode=7' member of (tidb_json_flatten(meta));
select id from t use index(idx_wb_meta) where wb_id = 1 and '$.cells.ccf_3.errorCode=7' member of (tidb_json_flatten(meta)) order by id;
explain format='brief' select id from t ignore index(idx_meta, idx_wb_meta) where '$.cells.ccf_3.errorCode=7' member of (tidb_json_flatten(meta));
update t set meta = json_set(meta, '$.cells.ccf_1.state', 'error') where id = 2;
delete from t where id = 1;
update t set meta = json_remove(meta, '$.cells.ccf_3', '$.cells.ccf_99') where id = 3;
select id from t use index(idx_meta) where '$.cells.ccf_1.state="error"' member of (tidb_json_flatten(meta)) order by id;
select id from t use index(idx_meta) where '$.cells.ccf_3.state="error"' member of (tidb_json_flatten(meta)) order by id;
admin check table t;
-- error 3907
insert into t (id, meta) values (10, json_object('note', repeat('x', 300)));
drop table t;

# TestTiDBJSONFlattenMaxLength
select tidb_json_flatten('{"a":"x"}', 64), tidb_json_flatten('{"a":"x"}', null);
select json_unquote(json_extract(tidb_json_flatten(json_object('a', repeat('x', 100)), 64), '$[0]')) as entry;
select char_length(json_unquote(json_extract(tidb_json_flatten(json_object('a', repeat('中', 100)), 64), '$[0]'))) as len;
-- error 1210
select tidb_json_flatten('{"a":"x"}', 63);
drop table if exists t;
create table t (id bigint primary key, meta json,
  index idx_meta ((cast(tidb_json_flatten(meta, 256) as char(256) array))));
insert into t values
 (1, json_object('cells', json_object('ccf_1', json_object('note', repeat('x', 300), 'state', 'error')))),
 (2, json_object('cells', json_object('ccf_1', json_object('note', repeat('y', 300), 'state', 'error')))),
 (3, '{"cells":{"ccf_1":{"state":"results"}}}');
admin check table t;
explain format='brief' select id from t where json_contains(tidb_json_flatten(meta, 256), tidb_json_flatten(json_object('cells', json_object('ccf_1', json_object('note', repeat('x', 300)))), 256));
select id from t where json_contains(tidb_json_flatten(meta, 256), tidb_json_flatten(json_object('cells', json_object('ccf_1', json_object('note', repeat('x', 300)))), 256));
select id from t where '$.cells.ccf_1.state="error"' member of (tidb_json_flatten(meta, 256)) order by id;
# Without the same max_length, the expression doesn't match the index.
explain format='brief' select id from t where '$.cells.ccf_1.state="error"' member of (tidb_json_flatten(meta));
drop table t;
