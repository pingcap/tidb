# TestMultiValuedIndexInCompoundIndex
drop table if exists t;
create table t (j json not null, str varchar(5),  KEY `idx` ((cast(`j` as unsigned array)),`str`));
insert into t values ('1', 'abcde');
drop table t;
create table t (j json not null, str varchar(5) collate utf8mb4_unicode_ci,  KEY `idx` ((cast(`j` as unsigned array)),`str`));
insert into t values ('1', 'abcde');
drop table t;
create table t (j json not null, str varchar(5) collate gbk_chinese_ci,  KEY `idx` ((cast(`j` as unsigned array)),`str`));
insert into t values ('1', 'abcde');
drop table t;

# TestMVIndexSkipCoveredJSONPredicateRecheck
drop table if exists t;
create table t (id bigint primary key, j json, index zips ((cast(json_extract(j, '$.zipcode') as unsigned array))));
insert into t values (1, '{"zipcode":[1,2]}'), (2, '{"zipcode":[3,4]}'), (3, '{"zipcode":[5,6]}'), (4, '{"zipcode":[]}'), (5, null);
# JSON_OVERLAPS can't be pushed down to TiKV, but the index ranges enforce it exactly, so no Selection is needed.
explain format='brief' select id from t use index(zips) where json_overlaps(j->'$.zipcode', '[1, 3, 7]');
select id from t use index(zips) where json_overlaps(j->'$.zipcode', '[1, 3, 7]') order by id;
# A condition the index ranges don't cover is still evaluated.
explain format='brief' select id from t use index(zips) where json_overlaps(j->'$.zipcode', '[1, 3, 7]') and json_overlaps(j->'$.zipcode', '[2, 6]');
select id from t use index(zips) where json_overlaps(j->'$.zipcode', '[1, 3, 7]') and json_overlaps(j->'$.zipcode', '[2, 6]') order by id;
# Inside a transaction, uncommitted rows come through UnionScan rather than the index, so the Selection is kept.
begin;
insert into t values (6, '{"zipcode":[3]}'), (7, '{"zipcode":[8]}');
explain format='brief' select id from t use index(zips) where json_overlaps(j->'$.zipcode', '[1, 3, 7]');
select id from t use index(zips) where json_overlaps(j->'$.zipcode', '[1, 3, 7]') order by id;
rollback;
drop table t;

# TestIssue73230
drop table if exists t;
create table t (id int primary key, a int, j json, index m ((cast(j as signed array))), index ia(a));
insert into t values (1, 1, '[1,2]'), (2, 1, '[1,1]'), (3, 2, '[3]'), (4, 2, '[2,1]'), (5, 3, '1'), (6, 3, null), (7, 3, '[]');
# json_contains with a path argument checks the value at that path. The MVIndex ranges are built from the candidate
# like the 2-arg form, and the original filter is kept to recheck the rows.
explain format='brief' select id from t use index(m) where json_contains(j, '1', '$[1]');
select id from t use index(m) where json_contains(j, '1', '$[1]') order by id;
select id from t ignore index(m) where json_contains(j, '1', '$[1]') order by id;
select id from t use index(m) where json_contains(j, '1', '$[5]') order by id;
select id from t use index(m) where json_contains(j, '1', '$[0]') order by id;
select id from t ignore index(m) where json_contains(j, '1', '$[0]') order by id;
select id from t use index(m) where json_contains(j, '1', '$') order by id;
select id from t ignore index(m) where json_contains(j, '1', '$') order by id;
explain format='brief' select id from t use index(m) where json_contains(j, '[1,2]', '$');
select id from t use index(m) where json_contains(j, '[1,2]', '$') order by id;
select id from t ignore index(m) where json_contains(j, '[1,2]', '$') order by id;
select id from t use index(m) where json_contains(j, '[1,1]', '$[1]') order by id;
select id from t ignore index(m) where json_contains(j, '[1,1]', '$[1]') order by id;
# A path that can't be pushed down: the filter stays in the root Selection.
explain format='brief' select id from t use index(m) where json_contains(j, '1', if(json_overlaps(j, '[1]'), '$[1]', '$[0]'));
select id from t use index(m) where json_contains(j, '1', if(json_overlaps(j, '[1]'), '$[1]', '$[0]')) order by id;
select id from t ignore index(m) where json_contains(j, '1', if(json_overlaps(j, '[1]'), '$[1]', '$[0]')) order by id;
select id from t use index(m) where json_contains(j, '1', if(json_overlaps(j, '[1]'), '$[5]', '$[0]')) order by id;
# OR type IndexMerge
explain format='brief' select /*+ use_index_merge(t, m) */ id from t where json_contains(j, '1', '$[1]') or json_contains(j, '3', '$[0]');
select /*+ use_index_merge(t, m) */ id from t where json_contains(j, '1', '$[1]') or json_contains(j, '3', '$[0]') order by id;
select id from t ignore index(m) where json_contains(j, '1', '$[1]') or json_contains(j, '3', '$[0]') order by id;
# AND type IndexMerge with a normal index
explain format='brief' select /*+ use_index_merge(t, m, ia) */ id from t where json_contains(j, '1', '$[1]') and a = 1;
select /*+ use_index_merge(t, m, ia) */ id from t where json_contains(j, '1', '$[1]') and a = 1 order by id;
select id from t ignore index(m) where json_contains(j, '1', '$[1]') and a = 1 order by id;
# AND type IndexMerge with two conditions on the MVIndex
explain format='brief' select /*+ use_index_merge(t, m) */ id from t where json_contains(j, '1', '$[1]') and 2 member of (j);
select /*+ use_index_merge(t, m) */ id from t where json_contains(j, '1', '$[1]') and 2 member of (j) order by id;
select id from t ignore index(m) where json_contains(j, '1', '$[1]') and 2 member of (j) order by id;
# The two-argument form still drops the filter.
explain format='brief' select id from t use index(m) where json_contains(j, '1');
select id from t use index(m) where json_contains(j, '1') order by id;
drop table t;
