use test;
drop table if exists inet6_invalid,t0;
create table inet6_invalid(id int primary key,s varchar(64));
insert into inet6_invalid values (1,'10.0.5.9'),(2,'bad'),(3,''),(4,null),(5,'::1');
set tidb_enable_vectorized_expression=0;
select id,hex(inet6_aton(s)) from inet6_invalid order by id;
show warnings;
set tidb_enable_vectorized_expression=1;
select id,hex(inet6_aton(s)) from inet6_invalid order by id;
show warnings;
create table t0(c0 text(97));
replace into t0 values ('+%o');
select ref0 from (select concat(t0.c0,inet6_aton(char(0.10720270255669206)) and (case ((t0.c0)<<(-638857355)) when (case t0.c0 when 1056566955 then -2046596771 else '9+*H2lg' end) then 'e' when t0.c0 then ((t0.c0)|(t0.c0)) else t0.c0 end)) as ref0,(not ('0')) as ref1 from t0) as s where ref1;
drop table inet6_invalid,t0;
set tidb_enable_vectorized_expression=default;
set @saved_inet6_sql_mode=@@sql_mode;
create table inet6_dml(id int primary key, a varbinary(16));
create table inet6_generated(s varchar(64), a varbinary(16) as (inet6_aton(s)) stored);
create table inet6_input(s varchar(64));
insert into inet6_input values ('bad');
set tidb_enable_vectorized_expression=0;
set sql_mode='STRICT_TRANS_TABLES';
-- error 1411
insert into inet6_dml values (1,inet6_aton('bad'));
-- error 1411
insert into inet6_dml select 2,inet6_aton(s) from inet6_input;
-- error 1411
insert into inet6_generated(s) values ('bad');
select count(*) from inet6_dml;
select count(*) from inet6_generated;
insert ignore into inet6_dml select 2,inet6_aton(s) from inet6_input;
show warnings;
select id,a is null from inet6_dml;
set sql_mode='';
insert into inet6_dml values (3,inet6_aton('bad'));
show warnings;
insert into inet6_generated(s) values ('bad');
show warnings;
select id,a is null from inet6_dml order by id;
select s,a is null from inet6_generated;
delete from inet6_dml;
delete from inet6_generated;
set tidb_enable_vectorized_expression=1;
set sql_mode='STRICT_TRANS_TABLES';
-- error 1411
insert into inet6_dml values (1,inet6_aton('bad'));
-- error 1411
insert into inet6_dml select 2,inet6_aton(s) from inet6_input;
-- error 1411
insert into inet6_generated(s) values ('bad');
select count(*) from inet6_dml;
select count(*) from inet6_generated;
insert ignore into inet6_dml select 2,inet6_aton(s) from inet6_input;
show warnings;
select id,a is null from inet6_dml;
set sql_mode='';
insert into inet6_dml values (3,inet6_aton('bad'));
show warnings;
insert into inet6_generated(s) values ('bad');
show warnings;
select id,a is null from inet6_dml order by id;
select s,a is null from inet6_generated;
delete from inet6_dml;
delete from inet6_generated;
drop table inet6_dml,inet6_generated,inet6_input;
set sql_mode=@saved_inet6_sql_mode;
set tidb_enable_vectorized_expression=default;
