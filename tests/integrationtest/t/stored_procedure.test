DROP PROCEDURE IF EXISTS sp_if;
DROP PROCEDURE IF EXISTS sp_case;
DROP PROCEDURE IF EXISTS sp_while;
DROP PROCEDURE IF EXISTS sp_repeat;
DROP PROCEDURE IF EXISTS sp_loop_leave;
DROP PROCEDURE IF EXISTS sp_local_vars;
DROP PROCEDURE IF EXISTS sp_swap;
DROP PROCEDURE IF EXISTS sp_mixed;
DROP PROCEDURE IF EXISTS sp_nested_blocks;
DROP PROCEDURE IF EXISTS sp_null_handling;
DROP PROCEDURE IF EXISTS sp_string_ops;
DROP PROCEDURE IF EXISTS sp_math;
DROP PROCEDURE IF EXISTS sp_fibonacci;
