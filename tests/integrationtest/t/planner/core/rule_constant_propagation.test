# TestRuleConstantPropagation
drop table if exists t, s;
create table t (id int, name varchar(10));
create table s (id int, name varchar(10));
explain format='plan_tree' select * from t, (select * from s where s.id>1) tmp where t.id=tmp.id; -- inner join;
explain format='plan_tree' select * from t, (select * from s where s.id>1) tmp where t.name=tmp.name; -- can't, without id equal predicate;
explain format='plan_tree' select * from t, (select name from s where s.id>1) tmp where t.name=tmp.name; -- can't, projection without id column;
explain format='plan_tree' select * from t, (select id as id1, name as name1 from s where s.id>1) tmp where t.id=tmp.id1; -- projection above of s.id>1;
explain format='plan_tree' select * from t, (select id +1 as id1 from s where s.id>1) tmp where t.id=tmp.id1; -- can't optimize, projection has column function;


# TestDifferentJoinTypeConstantPropagation
drop table if exists t, s;
create table t (id int, name varchar(10));
create table s (id int, name varchar(10));
explain format='plan_tree' select * from (select * from t where t.id >1) tmp1, (select * from s where s.id <4) tmp2 where tmp1.id=tmp2.id; -- inner join, both children can be optimized;
explain format='plan_tree' select * from (select * from t where t.id>1) tmp, s where tmp.id=s.id; -- inner join, child 0;
explain format='plan_tree' select * from (select * from t where t.id>1) tmp left join s on tmp.id=s.id; -- left join, only left child can be optimized;
explain format='plan_tree' select * from t left join (select * from s where s.id>1) tmp on t.id=tmp.id; -- can't, left join;
explain format='plan_tree' select * from t right join (select * from s where s.id>1) tmp on t.id=tmp.id; -- right join, only right child can be optimized;
explain format='plan_tree' select * from (select * from t where t.id>1) tmp  right join s on tmp.id=s.id; -- can't, right join;


# TestSelectionThroughPlanNode
drop table if exists t, s;
create table t (id int, name varchar(10));
create table s (id int, name varchar(10));
explain format='plan_tree' select * from t, (select id as id1 from s where s.id>1) tmp where t.id=tmp.id1; -- constant propagation can through the projection node;
explain format='plan_tree' select * from t, (select id, count(name) from s where s.id>1 group by id) tmp where t.id=tmp.id; -- can't, constant propagation can't through the aggregation node;
explain format='plan_tree' select * from t, (select id from s where s.id>1 order by id limit 2) tmp where t.id=tmp.id; -- can't, constant propagation can't through the sort node;


# TestUpdate
drop table if exists t, s;
create table t (id int, name varchar(10));
create table s (id int, name varchar(10));
explain format='plan_tree' Update t, (select * from s where s.id>1) tmp set t.name=tmp.name where t.id=tmp.id;


# TestMultiSubtreeMatch
drop table if exists t, s;
create table t (id int, name varchar(10));
create table s (id int, name varchar(10));
explain format='plan_tree' select * from (select * from (select t.id+1 as id1, t.name from t, (select * from s where s.id>1) s1 where t.id=s1.id ) tmp order by id1) a union (select tmp.* from (select * from t where t.id <3) tmp left join s on tmp.id=s.id); -- match twice;

create table t1(id int, value int);
create table t2(id int, value int);
INSERT INTO t1 (id, value) VALUES (10, 0),(20, 0),(30, 0);
INSERT INTO t2 (id, value) VALUES (10, 100), (10, 200), (10, 300), (20, 400), (30, 500);
explain format='plan_tree' update t1 set value = (select count(*) from t2 where t1.id = t2.id) where t1.id = 10;
update t1 set value = (select count(*) from t2 where t1.id = t2.id) where t1.id = 10;
select * from t1;
select * from t2;
drop table if exists t1, t2;

CREATE TABLE t2 (
    k INT,
    b INT
);

CREATE TABLE t3 (
    k INT,
    b INT
);
INSERT INTO t2 (k, b) VALUES
(1, 100),
(2, NULL),
(3, 300),
(NULL, 400),
(5, 500);
INSERT INTO t3 (k, b) VALUES
(1, 100),
(2, NULL),
(3, 300),
(NULL, 400),
(6, 600);
explain format = 'brief' select * from t2 where not exists (select 1 from t3 where t3.k = t2.k and t3.b = t2.b and t2.k = 1);
explain format = 'brief' select * from t2 where exists (select 1 from t3 where t3.k = t2.k and t3.b = t2.b and t2.k = 1);
EXPLAIN FORMAT = 'brief' SELECT * FROM t2
WHERE NOT EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
SELECT * FROM t2
WHERE NOT EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
EXPLAIN FORMAT = 'brief' SELECT * FROM t2
WHERE EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
SELECT * FROM t2
WHERE NOT EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
SELECT * FROM t2
WHERE NOT EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b AND t2.k = 1
);
DELETE FROM t3 WHERE k = 1 AND b = 100;
SELECT * FROM t2
WHERE EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
SELECT * FROM t2
WHERE NOT EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
SELECT * FROM t2
WHERE EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b
)
AND t2.k = 1;
SELECT * FROM t2
WHERE NOT EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b AND t2.k = 1
);
SELECT * FROM t2
WHERE EXISTS (
    SELECT 1 FROM t3
    WHERE t3.k = t2.k AND t3.b = t2.b AND t2.k = 1
);


# TestInListConstantPropagation
drop table if exists t, s, u, v;
create table t (id int, name varchar(10));
create table s (id int, name varchar(10));
create table u (id int, name varchar(10) collate utf8mb4_general_ci);
create table v (id int, name varchar(10) collate utf8mb4_general_ci);
insert into t values (1, 'a'), (2, 'b'), (3, 'c'), (null, 'n');
insert into s values (1, 'x'), (2, 'y'), (4, 'z'), (null, 'm');
insert into u values (1, 'a'), (2, 'b'), (3, 'c');
insert into v values (1, 'A'), (2, 'b'), (5, 'e');
explain format='plan_tree' select * from t, (select * from s where s.id in (1, 2)) tmp where t.id=tmp.id; -- inner join, IN is propagated to the other child;
explain format='plan_tree' select * from (select * from t where t.id in (1, 2)) tmp left join s on tmp.id=s.id; -- left join, IN on the outer child reaches the inner child;
explain format='plan_tree' select * from t left join (select * from s where s.id in (1, 2)) tmp on t.id=tmp.id; -- can't, IN is on the inner child of left join;
explain format='plan_tree' select * from (select * from t where t.id in (1, 2)) tmp right join s on tmp.id=s.id; -- can't, IN is on the inner child of right join;
explain format='plan_tree' select * from (select id as id1 from t where t.id in (1, 2)) tmp left join s on tmp.id1=s.id; -- IN passes through the projection;
explain format='plan_tree' select * from (select * from u where u.name in ('a', 'b')) tmp left join v on tmp.name=v.name; -- string IN, the constants' collation (connection collation) matches the column's;
explain format='plan_tree' select * from (select * from t where t.name in ('a', 'b')) tmp left join s on tmp.name=s.name; -- can't, the column is utf8mb4_bin but the constants have the connection collation;
explain format='plan_tree' select * from (select * from t where t.id in (1, length(t.name))) tmp left join s on tmp.id=s.id; -- can't, IN list has a non-constant item;
explain format='plan_tree' select * from (select * from t where t.id not in (1, 2)) tmp left join s on tmp.id=s.id; -- can't, NOT IN;
select * from (select * from t where t.id in (1, 2, 3)) tmp left join s on tmp.id=s.id order by tmp.id;
select * from t, (select * from s where s.id in (1, 2, 4)) tmp where t.id=tmp.id order by t.id;
select * from (select * from u where u.name in ('a', 'b')) tmp left join v on tmp.name=v.name order by tmp.id;

# Prepared planning wraps RANDOM_BYTES in a deferred Constant. The binary
# value X'FFFF' makes each filter's result independent of the random byte.
drop table if exists t_mutable, s_mutable;
create table t_mutable (k varbinary(2));
create table s_mutable (k varbinary(2) not null, marker int);
insert into t_mutable values (x'ffff');
insert into s_mutable values (x'ffff', 1);
set @old_prepare_cache = @@tidb_enable_prepared_plan_cache;
set @@tidb_enable_prepared_plan_cache = on;
set @enabled = 1;
prepare st from 'select count(*), count(s_mutable.marker)
  from (select k from t_mutable where k in (random_bytes(1), x''ffff'')) x
  left join s_mutable on x.k = s_mutable.k where ? = 1';
execute st using @enabled;
prepare st from 'select count(*), count(s_mutable.marker)
  from (select k from t_mutable where k = random_bytes(1)) x
  left join s_mutable on x.k = s_mutable.k where ? = 1';
execute st using @enabled;
prepare st from 'select count(*), count(s_mutable.marker)
  from (select k from t_mutable where k > random_bytes(1)) x
  left join s_mutable on x.k = s_mutable.k where ? = 1';
execute st using @enabled;
deallocate prepare st;
set @@tidb_enable_prepared_plan_cache = @old_prepare_cache;
drop table t_mutable, s_mutable;
