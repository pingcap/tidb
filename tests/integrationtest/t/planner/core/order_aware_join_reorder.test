# TestOrderAwareJoinReorderAlternativePlan
drop table if exists oa_order_t1, oa_order_t2, oa_order_t3, oa_order_t4;
create table oa_order_t1(
    id int not null primary key,
    category varchar(20),
    created_at int,
    key idx_category_created(category, created_at, id)
);
create table oa_order_t2(
    id int not null primary key,
    t1_id int not null,
    key idx_t1_id(t1_id)
);
create table oa_order_t3(
    id int not null primary key,
    t2_id int not null,
    key idx_t2_id(t2_id)
);
create table oa_order_t4(
    id int not null primary key,
    t3_id int not null,
    payload int,
    key idx_payload_t3(payload, t3_id)
);

set @@cte_max_recursion_depth = 10000;
insert into oa_order_t1
select n, 'hot', n from (
    with recursive seq(n) as (
        select 1
        union all
        select n + 1 from seq where n < 5000
    )
    select n from seq
) s;
insert into oa_order_t2
select n, n from (
    with recursive seq(n) as (
        select 1
        union all
        select n + 1 from seq where n < 5000
    )
    select n from seq
) s;
insert into oa_order_t3
select n, n from (
    with recursive seq(n) as (
        select 1
        union all
        select n + 1 from seq where n < 5000
    )
    select n from seq
) s;
insert into oa_order_t4
select n, n, if(n % 10 = 0, 1, 0) from (
    with recursive seq(n) as (
        select 1
        union all
        select n + 1 from seq where n < 5000
    )
    select n from seq
) s;
analyze table oa_order_t1, oa_order_t2, oa_order_t3, oa_order_t4 all columns;

set @@tidb_opt_join_reorder_through_sel = 1;
set @@tidb_opt_enable_advanced_join_reorder = 1;
set @@tidb_opt_enable_alternative_logical_plans = 0;
explain format = 'brief'
select oa_order_t1.created_at, oa_order_t4.payload
from oa_order_t2
join oa_order_t3 on oa_order_t3.t2_id = oa_order_t2.id
join oa_order_t1 on oa_order_t1.id = oa_order_t2.t1_id
join oa_order_t4 on oa_order_t4.t3_id = oa_order_t3.id
where oa_order_t1.category = 'hot' and oa_order_t4.payload = 1
order by oa_order_t1.created_at
limit 15;

set @@tidb_opt_enable_alternative_logical_plans = 1;
explain format = 'brief'
select oa_order_t1.created_at, oa_order_t4.payload
from oa_order_t2
join oa_order_t3 on oa_order_t3.t2_id = oa_order_t2.id
join oa_order_t1 on oa_order_t1.id = oa_order_t2.t1_id
join oa_order_t4 on oa_order_t4.t3_id = oa_order_t3.id
where oa_order_t1.category = 'hot' and oa_order_t4.payload = 1
order by oa_order_t1.created_at
limit 15;

select oa_order_t1.created_at, oa_order_t4.payload
from oa_order_t2
join oa_order_t3 on oa_order_t3.t2_id = oa_order_t2.id
join oa_order_t1 on oa_order_t1.id = oa_order_t2.t1_id
join oa_order_t4 on oa_order_t4.t3_id = oa_order_t3.id
where oa_order_t1.category = 'hot' and oa_order_t4.payload = 1
order by oa_order_t1.created_at
limit 15;

drop table oa_order_t1, oa_order_t2, oa_order_t3, oa_order_t4;
