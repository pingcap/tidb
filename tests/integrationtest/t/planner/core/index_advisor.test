# TestRecommendIndexReturnResult
drop table if exists t;
create table t (a int, b int);
delete from mysql.index_advisor_results where schema_name=database();
select count(*) from mysql.index_advisor_results where schema_name=database();
recommend index return result for 'select a from t where a=1';
select count(*) from mysql.index_advisor_results where schema_name=database();
recommend index run for 'select a from t where a=1';
select count(*) from mysql.index_advisor_results where schema_name=database();
update mysql.index_advisor_results set updated_at='2000-01-01', index_details='{}' where schema_name=database();
recommend index return result for 'select a from t where a=1';
recommend index return result for 'select b from t where b=1' with max_num_index=1;
select index_columns, updated_at, index_details from mysql.index_advisor_results where schema_name=database();
delete from mysql.index_advisor_results where schema_name=database();
drop table t;
