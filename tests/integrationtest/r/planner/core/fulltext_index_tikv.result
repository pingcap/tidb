explain format = 'brief' select id from articles where not match(body) against('+distributed' in boolean mode);
id	estRows	task	access object	operator info
Projection	8000.00	root		planner__core__fulltext_index_tikv.articles.id
└─Selection	8000.00	root		not(istrue_with_null(match_against("+distributed", planner__core__fulltext_index_tikv.articles.body)))
  └─TableReader	10000.00	root		data:TableFullScan
    └─TableFullScan	10000.00	cop[tikv]	table:articles	keep order:false, stats:pseudo
