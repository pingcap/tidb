drop table if exists t_bin, t_ci, t_gci;
create table t_bin (object_id bigint not null primary key, node_type varbinary(64) not null, creation_method varbinary(64) not null, key idx (node_type, creation_method, object_id));
insert into t_bin values (1,'A','x'),(2,'A','x'),(3,'A','y'),(4,'B','x'),(5,'B','y'),(6,'A ','x');
create table t_ci (object_id bigint not null primary key, node_type varchar(64) collate utf8_general_ci not null, creation_method varchar(64) collate utf8_general_ci not null, key idx (node_type, creation_method, object_id));
insert into t_ci values (1,'A','x'),(2,'a','X'),(3,'A','y'),(4,'B','x'),(5,'é','x');
create table t_gci (id int primary key, c varchar(10) collate utf8mb4_general_ci, key(c));
insert into t_gci values (1,'A'),(2,'a'),(3,'B');
explain format='brief' select * from t_bin where node_type = 'A' and creation_method = 'x' and ((node_type > 'A') or (node_type = 'A' and creation_method > 'x') or (node_type = 'A' and creation_method = 'x' and object_id > 1)) order by node_type, creation_method, object_id limit 100;
