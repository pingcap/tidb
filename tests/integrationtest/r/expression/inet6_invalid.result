1	0A000509
2	NULL
3	NULL
4	NULL
5	00000000000000000000000000000001
show warnings;
Level	Code	Message
Warning	1411	Incorrect string value: 'bad' for function inet6_aton
Warning	1411	Incorrect string value: '' for function inet6_aton
create table t0(c0 text(97));
replace into t0 values ('+%o');
select ref0 from (select concat(t0.c0,inet6_aton(char(0.10720270255669206)) and (case ((t0.c0)<<(-638857355)) when (case t0.c0 when 1056566955 then -2046596771 else '9+*H2lg' end) then 'e' when t0.c0 then ((t0.c0)|(t0.c0)) else t0.c0 end)) as ref0,(not ('0')) as ref1 from t0) as s where ref1;
ref0
+%o0
drop table inet6_invalid,t0;
set tidb_enable_vectorized_expression=default;
set @saved_inet6_sql_mode=@@sql_mode;
create table inet6_dml(id int primary key, a varbinary(16));
create table inet6_generated(s varchar(64), a varbinary(16) as (inet6_aton(s)) stored);
create table inet6_input(s varchar(64));
insert into inet6_input values ('bad');
set tidb_enable_vectorized_expression=0;
set sql_mode='STRICT_TRANS_TABLES';
insert into inet6_dml values (1,inet6_aton('bad'));
