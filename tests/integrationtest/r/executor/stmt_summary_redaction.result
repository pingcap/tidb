set global tidb_stmt_summary_refresh_interval = 3600;
set tidb_enable_non_prepared_plan_cache = 0;
create table sample_redaction (id int);
set global tidb_redact_log = ON;
set global tidb_enable_stmt_summary = 0;
set global tidb_enable_stmt_summary = 1;
select * from sample_redaction where id = 42;
id
select * from sample_redaction where id = 99;
id
select query_sample_text, exec_count from information_schema.statements_summary where digest_text = 'select * from `sample_redaction` where `id` = ?';
query_sample_text	exec_count
select * from sample_redaction where id = 42	2
select query_sample_text from information_schema.statements_summary_history where digest_text = 'select * from `sample_redaction` where `id` = ?';
query_sample_text
select * from sample_redaction where id = 42
set global tidb_redact_log = MARKER;
set global tidb_enable_stmt_summary = 0;
set global tidb_enable_stmt_summary = 1;
prepare s from 'select * from sample_redaction where id = ?';
set @id = 42;
execute s using @id;
id
select query_sample_text from information_schema.statements_summary where digest_text = 'select * from `sample_redaction` where `id` = ?';
query_sample_text
select * from sample_redaction where id = ? [arguments: 42]
deallocate prepare s;
set global tidb_redact_log = ON;
select query_sample_text from information_schema.statements_summary where digest_text = 'select * from `sample_redaction` where `id` = ?';
query_sample_text
select * from sample_redaction where id = ? [arguments: 42]
set global tidb_redact_log = OFF;
select query_sample_text from information_schema.statements_summary where digest_text = 'select * from `sample_redaction` where `id` = ?';
query_sample_text
select * from sample_redaction where id = ? [arguments: 42]
set global tidb_redact_log = ON;
create user sample_redaction_user identified by 'sample_password';
select query_sample_text from information_schema.statements_summary where stmt_type = 'CreateUser';
query_sample_text
create user {sample_redaction_user@% password = ***}
drop user sample_redaction_user;
drop table sample_redaction;
set global tidb_redact_log = default;
set global tidb_stmt_summary_refresh_interval = default;
set global tidb_enable_stmt_summary = default;
set tidb_enable_non_prepared_plan_cache = default;
