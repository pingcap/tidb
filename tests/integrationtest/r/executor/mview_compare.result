use test;
set time_zone = '+00:00';
insert into mysql.tidb(variable_name, variable_value, comment)
values ('tikv_gc_safe_point', '20060102-15:04:05 +0000', '')
on duplicate key update variable_value = values(variable_value);
create table t_compare (a int, b int not null);
insert into t_compare values (null, 10), (1, 20), (1, 30);
create materialized view log on t_compare (a, b);
create materialized view mv_compare (_Differ_type_, s, cnt)
as select a, sum(b), count(*) from t_compare group by a;
create table t_compare_snapshot (id int primary key);
insert into t_compare_snapshot values (1);
do sleep(0.01);
set @stale_ts = now(6);
do sleep(0.1);
start transaction read only as of timestamp @stale_ts;
set @transaction_ts = @@tidb_current_ts;
select id from t_compare_snapshot order by id;
id
1
insert into t_compare_snapshot values (2);
compare materialized view mv_compare as of timestamp @stale_ts;
compare result
There are no differences result in 0 rows compared to source base tables at timestamp '<timestamp>' (TSO: <tso>)
compare materialized view mv_compare as of timestamp @stale_ts output into table mv_compare_stale_output;
Error 1105 (HY000): only support read-only statement during read-only staleness transactions
select @@tidb_current_ts = @transaction_ts as same_transaction;
same_transaction
1
select id from t_compare_snapshot order by id;
id
1
select count(*) from information_schema.tables
where table_schema = 'test' and table_name = 'mv_compare_stale_output';
count(*)
0
rollback;
select id from t_compare_snapshot order by id;
id
1
2
drop table t_compare_snapshot;
drop materialized view mv_compare;
drop materialized view log on t_compare;
drop table t_compare;
