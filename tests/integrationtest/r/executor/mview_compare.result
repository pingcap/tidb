refresh materialized view mv_compare fast;
do sleep(0.01);
set @compare_ts = now(6);
do sleep(0.1);
compare materialized view mv_compare as of timestamp @compare_ts;
compare result
There are no differences result in 0 rows compared to source base tables at timestamp '<timestamp>' (TSO: <tso>)
refresh materialized view mv_compare complete out of place;
do sleep(0.01);
set @compare_ts = now(6);
do sleep(0.1);
compare materialized view mv_compare as of timestamp @compare_ts;
compare result
There are no differences result in 0 rows compared to source base tables at timestamp '<timestamp>' (TSO: <tso>)
compare materialized view mv_compare as of timestamp now(6) output into table mv_compare_output;
Error 1050 (42S01): Table 'test.mv_compare_output' already exists
compare materialized view t_compare as of timestamp now(6);
Error 1347 (HY000): 'test.t_compare' is not MATERIALIZED VIEW
drop table mv_compare_output;
drop materialized view mv_compare;
drop materialized view log on t_compare;
drop table t_compare;
create table t_compare_bit (id int primary key, g int, b bit(8), index (g, b));
insert into t_compare_bit values (1, 1, null), (2, 2, b'00000010');
create materialized view log on t_compare_bit (id, g, b);
create materialized view mv_compare_bit (g, m, cnt)
as select /*+ stream_agg() */ g, min(b), count(*) from t_compare_bit group by g;
set @bit_mview_id = (select tidb_table_id from information_schema.tables
where table_schema = 'test' and table_name = 'mv_compare_bit');
set @bit_read_tso = (select last_success_read_tso from mysql.tidb_mview_refresh_info
where mview_id = @bit_mview_id);
update t_compare_bit set b = b'00000011' where id = 2;
refresh materialized view mv_compare_bit complete in place;
update mysql.tidb_mview_refresh_info set last_success_read_tso = @bit_read_tso
where mview_id = @bit_mview_id;
do sleep(0.01);
set @compare_ts = now(6);
do sleep(0.1);
compare materialized view mv_compare_bit as of timestamp @compare_ts;
compare result
There are differences result in 1 rows compared to source base tables at timestamp '<timestamp>' (TSO: <tso>)
compare materialized view mv_compare_bit as of timestamp @compare_ts output into table mv_compare_bit_output;
select g, hex(m), cnt, _Differ_type_ from mv_compare_bit_output order by g;
g	hex(m)	cnt	_Differ_type_
2	3	1	mview_differ
drop table mv_compare_bit_output;
drop materialized view mv_compare_bit;
drop materialized view log on t_compare_bit;
drop table t_compare_bit;
drop database if exists mview_compare_privilege_test;
create database mview_compare_privilege_test;
use mview_compare_privilege_test;
create table t (a int not null, b int not null);
insert into t values (1, 10), (1, 5), (2, 7);
create materialized view log on t (a, b) purge next date_add(now(), interval 1 hour);
create materialized view mv (a, s, cnt) refresh fast next date_add(now(), interval 1 hour) as
select a, sum(b), count(1) from t group by a;
create user 'u_compare_none'@'%';
create user 'u_compare_operate'@'%';
grant operate view on mview_compare_privilege_test.mv to 'u_compare_operate'@'%';
create user 'u_compare_no_create'@'%';
grant operate view on mview_compare_privilege_test.mv to 'u_compare_no_create'@'%';
grant select on mview_compare_privilege_test.t to 'u_compare_no_create'@'%';
create user 'u_compare_no_insert'@'%';
grant operate view on mview_compare_privilege_test.mv to 'u_compare_no_insert'@'%';
grant select on mview_compare_privilege_test.t to 'u_compare_no_insert'@'%';
grant create on mview_compare_privilege_test.* to 'u_compare_no_insert'@'%';
create user 'u_compare_output_exists'@'%';
grant operate view on mview_compare_privilege_test.mv to 'u_compare_output_exists'@'%';
grant select on mview_compare_privilege_test.t to 'u_compare_output_exists'@'%';
grant create, insert on mview_compare_privilege_test.* to 'u_compare_output_exists'@'%';
create table mv_compare_output_exists (a int);
compare materialized view mview_compare_privilege_test.mv as of timestamp now();
Error 1142 (42000): OPERATE VIEW command denied to user 'u_compare_none'@'%' for table 'mv'
compare materialized view mv as of timestamp now();
Error 1142 (42000): SELECT command denied to user 'u_compare_operate'@'%' for table 't'
compare materialized view mv as of timestamp now() output into table mv_compare_output;
Error 1142 (42000): CREATE command denied to user 'u_compare_no_create'@'%' for table 'mv_compare_output'
compare materialized view mv as of timestamp now() output into table mv_compare_output;
Error 1142 (42000): INSERT command denied to user 'u_compare_no_insert'@'%' for table 'mv_compare_output'
compare materialized view mv as of timestamp now() output into table mv_compare_output_exists;
Error 1050 (42S01): Table 'mview_compare_privilege_test.mv_compare_output_exists' already exists
drop user if exists 'u_compare_none'@'%';
drop user if exists 'u_compare_operate'@'%';
drop user if exists 'u_compare_no_create'@'%';
drop user if exists 'u_compare_no_insert'@'%';
drop user if exists 'u_compare_output_exists'@'%';
drop database mview_compare_privilege_test;
use test;
set global tidb_mview_enable = off;
set tidb_mview_enable = off;
