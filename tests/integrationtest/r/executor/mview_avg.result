use test;
set tidb_mview_enable = on;
drop materialized view if exists mv_avg_e2e;
drop table if exists t_mv_avg_e2e;
create table t_mv_avg_e2e (a int not null, b int);
insert into t_mv_avg_e2e values (1, 1), (1, 2), (2, null);
create materialized view log on t_mv_avg_e2e (a, b) purge next date_add(now(), interval 1 hour);
set @@session.div_precision_increment = 4;
create materialized view mv_avg_e2e (a, cnt_all, avg_b, cnt_b, sum_b) refresh fast next date_add(now(), interval 1 hour) as
select a, count(*), avg(b), count(b), sum(b) from t_mv_avg_e2e group by a;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;
a	cnt_all	avg_b	cnt_b	sum_b
1	2	1.5000	2	3
2	1	NULL	0	NULL
set @@session.div_precision_increment = 0;
insert into t_mv_avg_e2e values (1, 4), (2, null), (3, 10);
delete from t_mv_avg_e2e where a = 1 and b = 1;
refresh materialized view mv_avg_e2e fast;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;
a	cnt_all	avg_b	cnt_b	sum_b
1	2	3.0000	2	6
2	2	NULL	0	NULL
3	1	10.0000	1	10
delete from t_mv_avg_e2e where a = 2 and b is null limit 1;
refresh materialized view mv_avg_e2e fast;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;
a	cnt_all	avg_b	cnt_b	sum_b
1	2	3.0000	2	6
2	1	NULL	0	NULL
3	1	10.0000	1	10
update t_mv_avg_e2e set b = 8 where a = 1 and b = 2;
refresh materialized view mv_avg_e2e complete in place;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;
a	cnt_all	avg_b	cnt_b	sum_b
1	2	6.0000	2	12
2	1	NULL	0	NULL
3	1	10.0000	1	10
insert into t_mv_avg_e2e values (3, 14);
refresh materialized view mv_avg_e2e complete out of place;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;
a	cnt_all	avg_b	cnt_b	sum_b
1	2	6.0000	2	12
2	1	NULL	0	NULL
3	2	12.0000	2	24
delete from t_mv_avg_e2e where a = 2;
insert into t_mv_avg_e2e values (4, 9);
refresh materialized view mv_avg_e2e complete delta apply;
select a, cnt_all, avg_b, cnt_b, sum_b from mv_avg_e2e order by a;
a	cnt_all	avg_b	cnt_b	sum_b
1	2	6.0000	2	12
3	2	12.0000	2	24
4	1	9.0000	1	9
set @@session.div_precision_increment = 4;
drop materialized view mv_avg_e2e;
drop materialized view log on t_mv_avg_e2e;
drop table if exists t_mv_avg_e2e;
drop materialized view if exists mv_avg_real_e2e;
drop table if exists t_mv_avg_real_e2e;
create table t_mv_avg_real_e2e (id int primary key, a int not null, f float, d double);
insert into t_mv_avg_real_e2e values
(1, 1, 1.1, 10.1), (2, 1, 2.2, 20.2), (3, 2, null, null);
create materialized view log on t_mv_avg_real_e2e (id, a, f, d) purge next date_add(now(), interval 1 hour);
create materialized view mv_avg_real_e2e
(a, avg_f, sum_f, cnt_f, avg_d, sum_d, cnt_d, cnt_all)
refresh fast as
select a, avg(f), sum(f), count(f), avg(d), sum(d), count(d), count(*)
from t_mv_avg_real_e2e group by a;
select a, round(avg_f, 4), round(sum_f, 4), cnt_f,
round(avg_d, 4), round(sum_d, 4), cnt_d, cnt_all
from mv_avg_real_e2e order by a;
a	round(avg_f, 4)	round(sum_f, 4)	cnt_f	round(avg_d, 4)	round(sum_d, 4)	cnt_d	cnt_all
1	1.65	3.3	2	15.15	30.3	2	2
2	NULL	NULL	0	NULL	NULL	0	1
insert into t_mv_avg_real_e2e values (4, 1, 4.4, 40.4), (5, 2, null, null), (6, 3, 30.3, 300.3);
delete from t_mv_avg_real_e2e where id = 1;
refresh materialized view mv_avg_real_e2e fast;
select a, round(avg_f, 4), round(sum_f, 4), cnt_f,
round(avg_d, 4), round(sum_d, 4), cnt_d, cnt_all
from mv_avg_real_e2e order by a;
a	round(avg_f, 4)	round(sum_f, 4)	cnt_f	round(avg_d, 4)	round(sum_d, 4)	cnt_d	cnt_all
1	3.3	6.6	2	30.3	60.6	2	2
2	NULL	NULL	0	NULL	NULL	0	2
3	30.3	30.3	1	300.3	300.3	1	1
update t_mv_avg_real_e2e set f = 8.8, d = 80.8 where id = 2;
refresh materialized view mv_avg_real_e2e fast;
select a, round(avg_f, 4), round(sum_f, 4), cnt_f,
round(avg_d, 4), round(sum_d, 4), cnt_d, cnt_all
from mv_avg_real_e2e order by a;
a	round(avg_f, 4)	round(sum_f, 4)	cnt_f	round(avg_d, 4)	round(sum_d, 4)	cnt_d	cnt_all
1	6.6	13.2	2	60.6	121.2	2	2
2	NULL	NULL	0	NULL	NULL	0	2
3	30.3	30.3	1	300.3	300.3	1	1
drop materialized view mv_avg_real_e2e;
drop materialized view log on t_mv_avg_real_e2e;
drop table if exists t_mv_avg_real_e2e;
create table t_mv_avg_real_not_null (id int primary key, a int not null, f float not null, d double not null);
insert into t_mv_avg_real_not_null values (1, 1, 10, 100), (2, 2, 20, 200);
create materialized view log on t_mv_avg_real_not_null (id, a, f, d) purge next date_add(now(), interval 1 hour);
create materialized view mv_avg_real_not_null (a, avg_f, sum_f, avg_d, sum_d, cnt_all)
refresh fast as select a, avg(f), sum(f), avg(d), sum(d), count(*) from t_mv_avg_real_not_null group by a;
create materialized view mv_avg_real_not_null_count (a, avg_f, sum_f, cnt_f, avg_d, sum_d, cnt_d, cnt_all)
refresh fast as select a, avg(f), sum(f), count(f), avg(d), sum(d), count(d), count(*) from t_mv_avg_real_not_null group by a;
delete from t_mv_avg_real_not_null where a = 1;
refresh materialized view mv_avg_real_not_null fast;
refresh materialized view mv_avg_real_not_null_count fast;
select * from mv_avg_real_not_null order by a;
a	avg_f	sum_f	avg_d	sum_d	cnt_all
2	20	20	200	200	1
select * from mv_avg_real_not_null_count order by a;
a	avg_f	sum_f	cnt_f	avg_d	sum_d	cnt_d	cnt_all
2	20	20	1	200	200	1	1
insert into t_mv_avg_real_not_null values (3, 1, 30, 300);
refresh materialized view mv_avg_real_not_null fast;
refresh materialized view mv_avg_real_not_null_count fast;
select * from mv_avg_real_not_null order by a;
a	avg_f	sum_f	avg_d	sum_d	cnt_all
1	30	30	300	300	1
2	20	20	200	200	1
select * from mv_avg_real_not_null_count order by a;
a	avg_f	sum_f	cnt_f	avg_d	sum_d	cnt_d	cnt_all
1	30	30	1	300	300	1	1
2	20	20	1	200	200	1	1
delete from t_mv_avg_real_not_null;
refresh materialized view mv_avg_real_not_null fast;
refresh materialized view mv_avg_real_not_null_count fast;
select count(*) from mv_avg_real_not_null;
count(*)
0
select count(*) from mv_avg_real_not_null_count;
count(*)
0
drop materialized view mv_avg_real_not_null;
drop materialized view mv_avg_real_not_null_count;
drop materialized view log on t_mv_avg_real_not_null;
drop table t_mv_avg_real_not_null;
create table t_mv_avg_case (a int not null, b int);
insert into t_mv_avg_case values (1, 10), (1, 20);
create materialized view log on t_mv_avg_case (a, b) purge next date_add(now(), interval 1 hour);
create materialized view mv_avg_case (a, av, s, c, n) refresh fast as
select a, avg(B), sum(b), count(B), count(*) from t_mv_avg_case group by a;
insert into t_mv_avg_case values (1, 30);
refresh materialized view mv_avg_case fast;
select * from mv_avg_case;
a	av	s	c	n
1	20.0000	60	3	3
drop materialized view mv_avg_case;
drop materialized view log on t_mv_avg_case;
drop table t_mv_avg_case;
set div_precision_increment = 0;
create table t_mv_avg_zero (a int not null, b int);
insert into t_mv_avg_zero values (1, 2), (1, 4);
create materialized view log on t_mv_avg_zero (a, b) purge next date_add(now(), interval 1 hour);
create materialized view mv_avg_zero (a, av, s, c, n) refresh fast as
select a, avg(b), sum(b), count(b), count(*) from t_mv_avg_zero group by a;
select column_type from information_schema.columns where table_schema='test' and table_name='mv_avg_zero' and column_name='av';
column_type
decimal(15,4)
select * from mv_avg_zero;
a	av	s	c	n
1	3.0000	6	2	2
set div_precision_increment = 30;
