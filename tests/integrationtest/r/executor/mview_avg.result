1	4.0000	12	3	3
refresh materialized view mv_avg_zero complete in place;
select * from mv_avg_zero;
a	av	s	c	n
1	4.0000	12	3	3
refresh materialized view mv_avg_zero complete out of place;
select * from mv_avg_zero;
a	av	s	c	n
1	4.0000	12	3	3
refresh materialized view mv_avg_zero complete delta apply;
select * from mv_avg_zero;
a	av	s	c	n
1	4.0000	12	3	3
drop materialized view mv_avg_zero;
drop materialized view log on t_mv_avg_zero;
drop table t_mv_avg_zero;
set div_precision_increment = 4;
