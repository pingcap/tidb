drop table if exists tkey;
create table tkey (col1 int not null, col2 varchar(32) not null, col3 int not null, unique(col1, col2)) partition by key(col2) partitions 4;
insert into tkey values(1, 'a', 1), (2, 'b', 2);
set session tidb_skip_missing_partition_stats=0;
set session tidb_opt_fix_control = "";
explain format='plan_tree' select col1, col2, col3 from tkey where col1 = 1 and col2 = 'a' or col1 = 3 and col2 = 'c';
id	task	access object	operator info
Batch_Point_Get	root	table:tkey, partition:p3, index:col1(col1, col2)	keep order:false, desc:false
select col1, col2, col3 from tkey where col1 = 1 and col2 = 'a' or col1 = 3 and col2 = 'c';
col1	col2	col3
1	a	1
drop table tkey;
create table t_partition_dirty(k int, p int, v int,
primary key(k,p) clustered, unique key uk(k) global)
partition by range(p) (partition p0 values less than(10),
partition p1 values less than(20), partition p2 values less than(maxvalue));
insert into t_partition_dirty values(1,1,10),(10,11,20);
set tidb_partition_prune_mode='dynamic';
set tidb_opt_fix_control='44262:ON';
begin;
insert into t_partition_dirty values(20,21,30);
update t_partition_dirty set v=11 where k=1;
explain format='plan_tree' select * from t_partition_dirty use index(primary)
where (k=1 and p=1) or (k=10 and p=11) or (k=20 and p=21);
id	task	access object	operator info
Projection	root		executor__batch_point_get.t_partition_dirty.k, executor__batch_point_get.t_partition_dirty.p, executor__batch_point_get.t_partition_dirty.v
└─Batch_Point_Get	root	table:t_partition_dirty, partition:p0,p1,p2, clustered index:PRIMARY(k, p)	keep order:false, desc:false
select * from t_partition_dirty use index(primary)
where (k=1 and p=1) or (k=10 and p=11) or (k=20 and p=21);
k	p	v
1	1	11
10	11	20
20	21	30
explain format='plan_tree' select * from t_partition_dirty use index(uk)
where (k=1 or k=10 or k=20) and v=11;
id	task	access object	operator info
Projection	root		executor__batch_point_get.t_partition_dirty.k, executor__batch_point_get.t_partition_dirty.p, executor__batch_point_get.t_partition_dirty.v
└─Selection	root		eq(executor__batch_point_get.t_partition_dirty.v, 11)
  └─Batch_Point_Get	root	table:t_partition_dirty, index:uk(k)	keep order:false, desc:false
select * from t_partition_dirty use index(uk)
where (k=1 or k=10 or k=20) and v=11;
k	p	v
1	1	11
savepoint before_move;
delete from t_partition_dirty where k=10;
update t_partition_dirty set p=11 where k=1;
select * from t_partition_dirty use index(primary)
where (k=1 and p=1) or (k=1 and p=11) or (k=10 and p=11) or (k=20 and p=21);
k	p	v
1	11	11
20	21	30
select * from t_partition_dirty use index(uk) where k=1 or k=10 or k=20;
k	p	v
1	11	11
20	21	30
select * from t_partition_dirty partition(p0) use index(uk) where k=1 or k=20;
k	p	v
select * from t_partition_dirty partition(p1) use index(uk) where k=1 or k=20;
k	p	v
1	11	11
rollback to savepoint before_move;
select * from t_partition_dirty use index(uk) where k=1 or k=10 or k=20;
k	p	v
1	1	11
10	11	20
20	21	30
rollback;
select * from t_partition_dirty use index(uk) where k=1 or k=10 or k=20;
k	p	v
1	1	10
10	11	20
drop table t_partition_dirty;
create table t_partition_coll(a varchar(20), p int, v int,
primary key(a,p) clustered, unique key uk(a) global)
collate=utf8mb4_unicode_ci partition by range(p)
(partition p0 values less than(10), partition p1 values less than(maxvalue));
insert into t_partition_coll values('Alpha',1,1),('Zulu',11,2);
begin;
update t_partition_coll set p=11,v=3 where a='Alpha';
explain format='plan_tree' select * from t_partition_coll use index(primary)
where (a='alpha ' and p=11) or (a='Zulu' and p=11);
