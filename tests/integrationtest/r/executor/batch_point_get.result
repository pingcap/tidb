└─Batch_Point_Get	root	table:t_partition_coll, partition:p1, clustered index:PRIMARY(a, p)	keep order:false, desc:false
select * from t_partition_coll use index(primary)
where (a='alpha ' and p=11) or (a='Zulu' and p=11);
a	p	v
Alpha	11	3
Zulu	11	2
explain format='plan_tree' select * from t_partition_coll use index(uk)
where (a='Alpha' or a='alpha ' or a='Zulu') and v>0;
id	task	access object	operator info
Projection	root		executor__batch_point_get.t_partition_coll.a, executor__batch_point_get.t_partition_coll.p, executor__batch_point_get.t_partition_coll.v
└─Selection	root		gt(executor__batch_point_get.t_partition_coll.v, 0)
  └─Batch_Point_Get	root	table:t_partition_coll, index:uk(a)	keep order:false, desc:false
select * from t_partition_coll use index(uk)
where (a='Alpha' or a='alpha ' or a='Zulu') and v>0;
a	p	v
Alpha	11	3
Zulu	11	2
rollback;
drop table t_partition_coll;
