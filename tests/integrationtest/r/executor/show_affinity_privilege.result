create database secret_db;
create database pub_db;
create table secret_db.secret_t (id int) affinity='table';
create table pub_db.part_t (id int) affinity='partition'
partition by range (id) (
partition p0 values less than (100),
partition p1 values less than maxvalue
);
create user nopriv;
show affinity;
Db_name	Table_name	Partition_name	Leader_store_id	Voter_store_ids	Status	Region_count	Affinity_region_count
pub_db	part_t	p0	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
pub_db	part_t	p1	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
secret_db	secret_t	NULL	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
show databases like '%_db';
Database (%_db)
show affinity;
Db_name	Table_name	Partition_name	Leader_store_id	Voter_store_ids	Status	Region_count	Affinity_region_count
grant select on pub_db.part_t to nopriv;
show affinity;
Db_name	Table_name	Partition_name	Leader_store_id	Voter_store_ids	Status	Region_count	Affinity_region_count
pub_db	part_t	p0	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
pub_db	part_t	p1	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
show affinity like 'part%';
Db_name	Table_name	Partition_name	Leader_store_id	Voter_store_ids	Status	Region_count	Affinity_region_count
pub_db	part_t	p0	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
pub_db	part_t	p1	<leader_store_id>	<voter_store_ids>	<status>	<region_count>	<affinity_region_count>
revoke select on pub_db.part_t from nopriv;
show affinity;
Db_name	Table_name	Partition_name	Leader_store_id	Voter_store_ids	Status	Region_count	Affinity_region_count
drop user nopriv;
drop database secret_db;
drop database pub_db;
