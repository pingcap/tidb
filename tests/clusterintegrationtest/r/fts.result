drop table if exists t1;
create table t1(
id INT PRIMARY KEY, title TEXT, body TEXT,
FULLTEXT KEY (title),
FULLTEXT KEY (body)
);
insert into t1 values (1, 'this is title', 'this is body');
insert into t1 values (2, 'hello world', 'hello world');
insert into t1 values (3, 'hello there', 'this is a test body');
insert into t1 values (4, 'random title', 'random body content');
insert into t1 values (5, 'hello world again', 'hello appears twice in this body hello');
insert into t1 values (6, 'another title', 'this body does not contain the keyword');
insert into t1 values (7, 'hello in title', 'but not in the body');
insert into t1 values (8, 'no keyword here', 'still no hello in this body');
insert into t1 values (9, 'hello hello hello', 'repeating hello multiple times in the title');
insert into t1 values (10, 'unique title', 'hello is only in the body this time');
insert into t1 values (11, 'hello and welcome', 'this body welcomes you with hello');
insert into t1 values (12, 'a title without hello', 'a body without hello as well');
insert into t1 values (13, 'hello in both', 'hello in the title and hello in the body');
insert into t1 values (14, 'just a title', 'hello is hidden in this body');
insert into t1 values (15, 'hello once', 'hello twice in this body hello');
insert into t1 values (16, 'no hello here', 'this body is completely unrelated');
insert into t1 values (17, 'hello at the start', 'and hello at the end hello');
insert into t1 values (18, 'a very long title without hello', 'but the body contains hello at the very end');
insert into t1 values (19, 'hello in uppercase', 'HELLO in the body as well');
insert into t1 values (20, 'mixed case Hello', 'the body says hello in lowercase');
delete from t1 where id <= 5;
