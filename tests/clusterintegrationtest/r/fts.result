drop table if exists fts_parameterized_score;
create table fts_parameterized_score(
row_id INT PRIMARY KEY,
fs_id VARCHAR(32),
content_text TEXT,
FULLTEXT KEY ft_content_fs(content_text WITH (STANDARD), fs_id WITH (EXACT))
);
insert into fts_parameterized_score values
(1, 'tenant-a', 'hello from tenant a one'),
(2, 'tenant-a', 'hello from tenant a two'),
(3, 'tenant-a', 'hello from tenant a three'),
(4, 'tenant-a', 'hello from tenant a four'),
(5, 'tenant-a', 'hello from tenant a five'),
(6, 'tenant-a', 'hello from tenant a six'),
(7, 'tenant-a', 'hello from tenant a seven'),
(8, 'tenant-a', 'hello from tenant a eight'),
(9, 'tenant-a', 'hello from tenant a nine'),
(10, 'tenant-a', 'hello from tenant a ten'),
(11, 'tenant-a', 'hello from tenant a eleven'),
(12, 'tenant-b', 'hello from tenant b');
prepare fts_parameterized_score_stmt from 'select group_concat(distinct fs_id) as fs_ids, count(*) as row_count, max(score) >= min(score) as valid_score_range from (select fs_id, fts_match_word("hello", content_text) as score from fts_parameterized_score where fs_id = ? and fts_match_word("hello", content_text) order by score desc limit 10) q';
set @fs_id = 'tenant-a';
execute fts_parameterized_score_stmt using @fs_id;
fs_ids	row_count	valid_score_range
tenant-a	10	1
select @@last_plan_from_cache;
@@last_plan_from_cache
0
set @fs_id = 'tenant-b';
execute fts_parameterized_score_stmt using @fs_id;
fs_ids	row_count	valid_score_range
tenant-b	1	1
select @@last_plan_from_cache;
@@last_plan_from_cache
0
deallocate prepare fts_parameterized_score_stmt;
